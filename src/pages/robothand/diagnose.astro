  const byId = new Map(TESTS.map((t) => [t.id, t]))

  function setModelLoading(text, percent) {
    const wrap = document.getElementById('model-loading')
    const textEl = document.getElementById('model-loading-text')
    const bar = document.getElementById('model-progress-bar')
    if (!wrap || !textEl || !bar) return
    wrap.hidden = false
    textEl.textContent = text
    bar.style.width = `${Math.max(0, Math.min(100, percent))}%`
  }

  function hideModelLoading() {
    const wrap = document.getElementById('model-loading')
    if (wrap) wrap.hidden = true
  }

  function fetchModelWithProgress(url) {
    return new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest()
      xhr.open('GET', url, true)
      xhr.responseType = 'arraybuffer'
      xhr.onprogress = (event) => {
        if (event.lengthComputable && event.total) {
          const percent = Math.min(100, Math.round((event.loaded / event.total) * 100))
          setModelLoading(
            `正在下载手部模型压缩包（约 ${(event.total / 1048576).toFixed(1)} MB） ${percent}%`,
            percent
          )
        }
      }
      xhr.onload = () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          resolve(xhr.response)
        } else {
          reject(new Error(`模型下载失败 HTTP ${xhr.status}`))
        }
      }
      xhr.onerror = () => reject(new Error('模型下载网络错误'))
      xhr.onabort = () => reject(new Error('模型下载被取消'))
      xhr.send()
    })
  }

  async function loadModelBuffer() {
    const cached = await readModelFromCache()
    if (cached && cached.byteLength >= 1000000) {
      setModelLoading('已从本地缓存读取手部模型', 100)
      return cached
    }

    let buffer = null
    if (typeof DecompressionStream === 'function') {
      try {
        const payload = await fetchModelWithProgress(MODEL_GZ_PATH)
        buffer = await maybeGunzip(payload)
      } catch (err) {
        buffer = null
      }
    }
    if (!buffer || buffer.byteLength < 1000000) {
      buffer = await fetchModelWithProgress(MODEL_PATH)
    }
    await writeModelToCache(buffer)
    return buffer
  }

  // 服务器可能给 .gz 带上 Content-Encoding: gzip，此时浏览器已自动解压。
  // 用 gzip 魔数判断是否仍需手动解压，避免重复解压导致回退再下载一次。
  async function maybeGunzip(payload) {
    const head = new Uint8Array(payload.slice(0, 2))
    const isGzip = head[0] === 0x1f && head[1] === 0x8b
    if (!isGzip) return payload
    const stream = new Blob([payload]).stream().pipeThrough(new DecompressionStream('gzip'))
    return new Response(stream).arrayBuffer()
  }

  function openModelCache() {
    return new Promise((resolve, reject) => {
      if (typeof indexedDB === 'undefined') {
        reject(new Error('indexedDB 不可用'))
        return
      }
      const request = indexedDB.open(MODEL_CACHE_DB, 1)
      request.onupgradeneeded = () => {
        const db = request.result
        if (!db.objectStoreNames.contains(MODEL_CACHE_STORE)) {
          db.createObjectStore(MODEL_CACHE_STORE)
        }
      }
      request.onsuccess = () => resolve(request.result)
      request.onerror = () => reject(request.error || new Error('打开缓存失败'))
    })
  }

  async function readModelFromCache() {
    try {
      const db = await openModelCache()
      return await new Promise((resolve) => {
        const tx = db.transaction(MODEL_CACHE_STORE, 'readonly')
        const req = tx.objectStore(MODEL_CACHE_STORE).get(MODEL_CACHE_KEY)
        req.onsuccess = () => resolve(req.result || null)
        req.onerror = () => resolve(null)
      })
    } catch (err) {
      return null
    }
  }

  async function writeModelToCache(buffer) {
    try {
      const db = await openModelCache()
      await new Promise((resolve) => {
        const tx = db.transaction(MODEL_CACHE_STORE, 'readwrite')
        tx.objectStore(MODEL_CACHE_STORE).put(buffer, MODEL_CACHE_KEY)
        tx.oncomplete = () => resolve()
        tx.onerror = () => resolve()
        tx.onabort = () => resolve()
      })
    } catch (err) {
      // 缓存写入失败不影响本次使用。
    }
  }

  async function clearModelCache() {
    try {
      const db = await openModelCache()
      await new Promise((resolve) => {
        const tx = db.transaction(MODEL_CACHE_STORE, 'readwrite')
        tx.objectStore(MODEL_CACHE_STORE).delete(MODEL_CACHE_KEY)
        tx.oncomplete = () => resolve()
        tx.onerror = () => resolve()
        tx.onabort = () => resolve()
      })
      return true
    } catch (err) {
      return false
    }
  }

  function detectPlatform() {
    const ua = navigator.userAgent || ''
    const ios = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
    const android = /Android/i.test(ua)
    let os = 'Windows'
    if (ios) os = 'iOS'
    else if (android) os = 'Android'
    else if (/Mac OS X/i.test(ua)) os = 'macOS'
    else if (/Linux/i.test(ua)) os = 'Linux'

    let browser = '未知浏览器'
    if (/Edg\//i.test(ua)) browser = 'Microsoft Edge'
    else if (/Chrome\//i.test(ua) && !/Edg\//i.test(ua)) browser = 'Chrome / Chromium'
    else if (/Firefox\//i.test(ua)) browser = 'Firefox'
    else if (/Bluefy/i.test(ua)) browser = 'Bluefy'
    else if (/Safari\//i.test(ua) && !/Chrome\//i.test(ua)) {
      browser = ios && 'bluetooth' in navigator ? 'Bluefy / Web BLE 浏览器' : 'Safari'
    }
    else if (ios && 'bluetooth' in navigator) browser = 'iOS Web BLE 浏览器'
    return { os, browser, ios, android, ua }
  }

  function patch(id, data) {
    const test = byId.get(id)
    if (!test) return
    Object.assign(test, data)
    renderTest(id)
    updateSummary()
  }

  function renderTest(id) {
    const test = byId.get(id)
    const row = document.querySelector(`[data-test-id="${id}"]`)
    if (!row) return
    const statusEl = row.querySelector('.rh-status')
    statusEl.className = `rh-status ${test.status || 'pending'}`
    statusEl.textContent = statusText(test.status)
    const detailEl = row.querySelector('.rh-test-detail')
    detailEl.textContent = test.actual ? `实际: ${test.actual}` : '尚未执行'
    const errBox = row.querySelector('.rh-error')
    if (test.errorMessage || test.errorName) {
      errBox.hidden = false
      errBox.innerHTML = ''
      const strong = document.createElement('strong')
      strong.textContent = `错误位置: ${test.name}`
      errBox.appendChild(strong)
      const line = document.createElement('div')
      line.textContent = `${test.errorName || 'Error'}: ${test.errorMessage || '未知错误'}`
      errBox.appendChild(line)
      if (test.stack) {
        const stack = document.createElement('div')
        stack.textContent = test.stack.split('\n').slice(0, 4).join('\n')
        errBox.appendChild(stack)
      }
    } else {
      errBox.hidden = true
      errBox.innerHTML = ''
    }
    const suggestion = row.querySelector('.rh-suggestion')
    suggestion.textContent = test.suggestion ? `建议: ${test.suggestion}` : ''
    const btn = row.querySelector('.rh-action-btn')
    if (btn) {
      if (test.interactive) {
        btn.textContent = test.actionLabel || '执行'
      } else if (test.status && test.status !== 'pending') {
        btn.textContent = '重测'
      } else {
        btn.textContent = '执行'
      }
      btn.disabled = state.busy || test.status === 'running'
    }
  }

  function updateButtons() {
    for (const test of TESTS) {
      const row = document.querySelector(`[data-test-id="${test.id}"]`)
      const btn = row && row.querySelector('.rh-action-btn')
      if (btn) {
        btn.disabled = state.busy || test.status === 'running'
      }
    }
  }

  function statusText(status) {
    return {
      pending: '待测',
      running: '运行中',
      pass: '通过',
      warn: '警告',
      fail: '失败',
      skip: '跳过'
    }[status] || '待测'
  }

  function renderTests() {
    const container = document.getElementById('tests')
    container.innerHTML = ''
    for (const test of TESTS) {
      const row = document.createElement('article')
      row.className = 'rh-test-row'
      row.dataset.testId = test.id

      const head = document.createElement('div')
      head.className = 'rh-test-head'

      const titleWrap = document.createElement('div')
      const title = document.createElement('h2')
      title.className = 'rh-test-title'
      title.textContent = `${test.group} / ${test.name}`
      const meta = document.createElement('p')
      meta.className = 'rh-test-meta'
      meta.textContent = `期望: ${test.expected}`
      titleWrap.appendChild(title)
      titleWrap.appendChild(meta)
      head.appendChild(titleWrap)

      const status = document.createElement('span')
      status.className = 'rh-status pending'
      status.textContent = '待测'
      head.appendChild(status)
      row.appendChild(head)

      const detail = document.createElement('div')
      detail.className = 'rh-test-detail'
      detail.textContent = '尚未执行'
      row.appendChild(detail)

      const suggestion = document.createElement('div')
      suggestion.className = 'rh-test-detail rh-suggestion'
      row.appendChild(suggestion)

      const error = document.createElement('div')
      error.className = 'rh-error'
      error.hidden = true
      row.appendChild(error)

      if (test.interactive || test.auto) {
        const actionRow = document.createElement('div')
        actionRow.className = 'rh-action-row'
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'rh-action-btn'
        btn.textContent = test.interactive ? (test.actionLabel || '执行') : '执行'
        btn.addEventListener('click', () => runTest(test.id))
        actionRow.appendChild(btn)
        row.appendChild(actionRow)
      }

      container.appendChild(row)
    }
  }

  async function runAutoTests() {
    if (state.busy) return
    state.busy = true
    updateButtons()
    try {
      for (const test of TESTS) {
        if (!test.auto) continue
        try {
          await executeTest(test.id, 0)
        } catch (err) {
          if (test.status === 'pending' || test.status === 'running') {
            patch(test.id, {
              status: 'fail',
              actual: `前置步骤未完成: ${err.message || err}`,
              errorName: err.name || 'Error',
              errorMessage: err.message || String(err),
              errorStack: err.stack || '',
              suggestion: '请先完成前置步骤，或点击对应测试项查看失败原因。'
            })
          }
        }
      }
      updateSummary()
    } finally {
      state.busy = false
      updateButtons()
      updateSummary()
    }
  }

  async function runTest(id) {
    const test = byId.get(id)
    if (!test || state.busy || test.status === 'running') return
    state.busy = true
    try {
      await executeTest(id, 0)
    } catch (err) {
      if (test.status === 'pending' || test.status === 'running') {
        patch(id, {
          status: 'fail',
          actual: `前置步骤未完成: ${err.message || err}`,
          errorName: err.name || 'Error',
          errorMessage: err.message || String(err),
          errorStack: err.stack || '',
          suggestion: '请先完成前置步骤，或点击对应测试项查看失败原因。'
        })
      }
    } finally {
      state.busy = false
      updateButtons()
      updateSummary()
    }
  }

  async function executeTest(id, depth) {
    const test = byId.get(id)
    if (!test) return
    if (depth > 8) throw new Error('前置步骤嵌套过深')
    if (test.requires && test.requires.length) {
      for (const requiredId of test.requires) {
        const required = byId.get(requiredId)
        if (!required) continue
        if (required.status !== 'pass' && required.status !== 'warn') {
          await executeTest(requiredId, depth + 1)
          if (required.status !== 'pass' && required.status !== 'warn') {
            throw new Error(`“${required.name}”未通过: ${required.actual || required.errorMessage || '请先执行该步骤'}`)
          }
        }
      }
    }
    if (test.status === 'running') return
    patch(id, {
      status: 'running',
      actual: '',
      errorName: '',
      errorMessage: '',
      errorStack: '',
      suggestion: ''
    })
    try {
      const result = await test.run()
      patch(id, {
        status: result.status || 'pass',
        actual: result.actual || '',
        suggestion: result.suggestion || ''
      })
    } catch (err) {
      patch(id, {
        status: 'fail',
        actual: `抛出异常: ${err.message || err}`,
        errorName: err.name || 'Error',
        errorMessage: err.message || String(err),
        errorStack: err.stack || '',
        suggestion: suggestFor(id, err)
      })
    }
  }

  function suggestFor(id, err) {
    const info = detectPlatform()
    if (err.name === 'NotAllowedError') {
      return '权限被拒绝。请在系统设置或浏览器设置中允许摄像头/蓝牙权限。'
    }
    if (err.name === 'NotFoundError') {
      return id.startsWith('camera') ? '没有检测到可用摄像头。' : '没有发现匹配的 BLE 设备。'
    }
    if (err.name === 'NotReadableError') {
      return '摄像头正被其他程序占用，请关闭其他应用后重试。'
    }
    if (err.name === 'SecurityError') {
      return '浏览器安全策略阻止该操作，请确认页面使用 HTTPS 并重新授权。'
    }
    if (err.name === 'NetworkError') {
      return '模型或 WASM 下载失败，请检查网络后重试。'
    }
    if (id === 'ble-discover' && info.ios) {
      return 'iOS 普通 Safari 不支持 Web Bluetooth，请复制链接到 Bluefy 中打开。'
    }
    if (id === 'mediapipe-init' && info.ios) {
      return 'Bluefy 的 WebKit 兼容性需要真机验证；如果失败，请先测试手动 BLE 和摄像头功能。'
    }
    return ''
  }

  async function stopCamera() {
    stopGestureDetection({ status: 'warn', actual: '手势识别已停止', suggestion: '摄像头被关闭或重新打开。' })
    if (state.cameraStream) {
      for (const track of state.cameraStream.getTracks()) track.stop()
      state.cameraStream = null
    }
    const video = document.getElementById('camera-video')
    if (video) video.srcObject = null
    stopGestureLoop()
  }

  function stopGestureLoop() {
    if (state.gestureRaf) cancelAnimationFrame(state.gestureRaf)
    state.gestureRaf = 0
  }

  function runGestureDetection() {
    if (state.gestureRunning) {
      return { status: 'running', actual: '手势识别已在运行中' }
    }
    state.gestureRunning = true
    state.gestureSeen = false
    state.gestureFrames = 0
    state.gestureHandFrames = 0
    state.gestureLastDebug = 0
    state.gestureLastDetect = 0
    state.gestureTimestamp = 0
    document.getElementById('stopGesture').hidden = false
    document.getElementById('gesture-status').textContent = '正在识别，请把手放到画面中央'
    document.getElementById('gesture-debug').textContent = '调试: 正在初始化识别循环'
    const video = document.getElementById('camera-video')
    const canvas = document.getElementById('gesture-canvas')
    const ctx = canvas.getContext('2d')

    const tick = () => {
      if (!state.gestureRunning) return
      if (document.hidden) {
        state.gestureRaf = requestAnimationFrame(tick)
        return
      }
      if (video.readyState < 2) {
        state.gestureRaf = requestAnimationFrame(tick)
        return
      }
      const w = video.videoWidth
      const h = video.videoHeight
      if (!w || !h) {
        state.gestureRaf = requestAnimationFrame(tick)
        return
      }
      const now = performance.now()
      if (now - state.gestureLastDetect < DETECT_INTERVAL_MS) {
        state.gestureRaf = requestAnimationFrame(tick)
        return
      }
      state.gestureLastDetect = now
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w
        canvas.height = h
      }
      ctx.clearRect(0, 0, w, h)
      try {
        state.gestureFrames++
        state.gestureTimestamp = Math.max(state.gestureTimestamp + 1, Math.round(now))
        const result = state.landmarker.detectForVideo(video, state.gestureTimestamp)
        const handLandmarks = result.landmarks || result.handLandmarks
        if (handLandmarks && handLandmarks.length) {
          state.gestureHandFrames++
          const landmarks = handLandmarks[0]
          drawHand(ctx, landmarks, w, h)
          const gesture = recognize(landmarks)
          document.getElementById('gesture-status').textContent = `识别到: ${gesture.name}`
          state.gestureSeen = true
          onGestureFrame(gesture)
        } else {
          document.getElementById('gesture-status').textContent = state.gestureSeen
            ? '手已离开画面，请把手放回来'
            : '等待手进入画面，请把手放到摄像头前'
        }
        if (state.gestureFrames - state.gestureLastDebug >= 30) {
          state.gestureLastDebug = state.gestureFrames
          const debugEl = document.getElementById('gesture-debug')
          debugEl.textContent = [
            '调试: 识别调用正常',
            `摄像头: ${w}x${h}`,
            `已处理帧: ${state.gestureFrames}`,
            `检测到手帧: ${state.gestureHandFrames}`,
            `手部结果: ${handLandmarks ? handLandmarks.length : 0}`
          ].join('\n')
        }
      } catch (err) {
        document.getElementById('gesture-debug').textContent = `调试: ${err.message || err}`
        stopGestureDetection({ status: 'fail', actual: `识别异常: ${err.message}`, suggestion: err.message })
        return
      }
      state.gestureRaf = requestAnimationFrame(tick)
    }

    state.gestureRaf = requestAnimationFrame(tick)
    return { status: 'running', actual: '手势识别已启动，请把手放到摄像头前' }
  }

  function stopGestureDetection(result) {
    if (!state.gestureRunning) return
    state.gestureRunning = false
    stopGestureLoop()
    const stopButton = document.getElementById('stopGesture')
    if (stopButton) stopButton.hidden = true
    const finalResult = result || (state.gestureSeen
      ? { status: 'pass', actual: '手势识别已停止，识别过程中已检测到手部关键点', suggestion: '' }
      : {
          status: 'warn',
          actual: '停止手势识别，未检测到手部',
          suggestion: '请把手放到摄像头画面中央、光线充足后重新开始。'
        })
    patch('gesture-detect', finalResult)
    const canvas = document.getElementById('gesture-canvas')
    const ctx = canvas && canvas.getContext('2d')
    if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height)
  }

  function showCameraPanel() {
    const panel = document.getElementById('camera-preview')
    const body = document.getElementById('camera-body')
    const button = document.getElementById('minimizeCamera')
    if (!panel || !body || !button) return
    panel.hidden = false
    state.cameraMinimized = false
    panel.classList.remove('rh-preview--minimized')
    body.hidden = false
    button.textContent = '收起'
  }

  function toggleCameraMinimized() {
    const panel = document.getElementById('camera-preview')
    const body = document.getElementById('camera-body')
    const button = document.getElementById('minimizeCamera')
    if (!panel || !body || !button) return
    state.cameraMinimized = !state.cameraMinimized
    panel.classList.toggle('rh-preview--minimized', state.cameraMinimized)
    body.hidden = state.cameraMinimized
    button.textContent = state.cameraMinimized ? '展开' : '收起'
  }

  function closeCameraPanel() {
    stopGestureDetection({ status: 'warn', actual: '手势识别已停止', suggestion: '摄像头已关闭。' })
    stopCamera()
    const panel = document.getElementById('camera-preview')
    if (panel) panel.hidden = true
    patch('camera-open', {
      status: 'pending',
      actual: '摄像头已手动关闭',
      suggestion: '点击“打开摄像头”可重新开启。'
    })
  }

  function setupCameraDrag() {
    const panel = document.getElementById('camera-preview')
    const handle = document.getElementById('cameraDragHandle')
    if (!panel || !handle) return
    let drag = null

    handle.addEventListener('pointerdown', (event) => {
      if (event.target.closest('button')) return
      const rect = panel.getBoundingClientRect()
      drag = {
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        left: rect.left,
        top: rect.top
      }
      handle.setPointerCapture(event.pointerId)
    })

    handle.addEventListener('pointermove', (event) => {
      if (!drag || drag.pointerId !== event.pointerId) return
      const nextLeft = drag.left + event.clientX - drag.startX
      const nextTop = drag.top + event.clientY - drag.startY
      const maxLeft = window.innerWidth - panel.offsetWidth - 6
      const maxTop = window.innerHeight - 48
      panel.style.left = `${Math.max(6, Math.min(maxLeft, nextLeft))}px`
      panel.style.top = `${Math.max(6, Math.min(maxTop, nextTop))}px`
      panel.style.right = 'auto'
      panel.style.bottom = 'auto'
    })

    const endDrag = (event) => {
      if (!drag || drag.pointerId !== event.pointerId) return
      drag = null
      if (handle.hasPointerCapture && handle.hasPointerCapture(event.pointerId)) {
        handle.releasePointerCapture(event.pointerId)
      }
    }
    handle.addEventListener('pointerup', endDrag)
    handle.addEventListener('pointercancel', endDrag)
  }

  function drawHand(ctx, landmarks, width, height) {
    ctx.strokeStyle = '#22c55e'
    ctx.lineWidth = 3
    ctx.beginPath()
    for (const [a, b] of HAND_CONNECTIONS) {
      const p1 = landmarks[a]
      const p2 = landmarks[b]
      if (!p1 || !p2) continue
      ctx.moveTo(p1.x * width, p1.y * height)
      ctx.lineTo(p2.x * width, p2.y * height)
    }
    ctx.stroke()
    ctx.fillStyle = '#ef4444'
    for (const p of landmarks) {
      ctx.beginPath()
      ctx.arc(p.x * width, p.y * height, 4, 0, Math.PI * 2)
      ctx.fill()
    }
  }

  function dist(a, b) {
    return Math.hypot(a.x - b.x, a.y - b.y)
  }

  function angle3(a, b, c) {
    const v1 = [a.x - b.x, a.y - b.y, a.z - b.z]
    const v2 = [c.x - b.x, c.y - b.y, c.z - b.z]
    const dot = v1[0] * v2[0] + v1[1] * v2[1] + v1[2] * v2[2]
    const len = Math.hypot(...v1) * Math.hypot(...v2)
    if (!len) return 0
    return Math.acos(Math.max(-1, Math.min(1, dot / len))) * 180 / Math.PI
  }

  function recognize(landmarks) {
    const tips = [4, 8, 12, 16, 20]
    const pips = [2, 6, 10, 14, 18]
    const wrist = landmarks[0]
    const fingers = [0, 0, 0, 0, 0]
    for (let i = 0; i < tips.length; i++) {
      const tip = landmarks[tips[i]]
      const pip = landmarks[pips[i]]
      if (dist(tip, wrist) > dist(pip, wrist) * 0.8) fingers[i] = 1
    }
    fingers[0] = angle3(landmarks[2], landmarks[3], landmarks[4]) > 160 ? 1 : 0
    const count = fingers.reduce((sum, v) => sum + v, 0)
    let name = `手势 ${count}`
    if (count === 0) name = '握拳 (Fist)'
    else if (count === 5) name = '张开 (Open Palm)'
    else {
      const labels = ['拇指', '食指', '中指', '无名指', '小指']
      name = labels.filter((_, i) => fingers[i]).join(' + ') || '握拳'
    }
    return { fingers, name }
  }

  // ---------- 机械手指令测试（与桌面上位机行为一致） ----------

  function logCommand(text) {
    const el = document.getElementById('commandLog')
    if (!el) return
    const stamp = new Date().toLocaleTimeString('zh-CN', { hour12: false })
    const line = `[${stamp}] ${text}`
    el.textContent = el.textContent === '暂无指令' ? line : `${el.textContent}\n${line}`
    el.scrollTop = el.scrollHeight
  }

  function setHandStatus(text) {
    const el = document.getElementById('handStatus')
    if (el) el.textContent = text
  }

  function handConnected() {
    return Boolean(state.handChar && state.handServer && state.handServer.connected)
  }

  function updateHandUi() {
    const connected = handConnected()
    const connectBtn = document.getElementById('connectHand')
    const disconnectBtn = document.getElementById('disconnectHand')
    if (connectBtn) connectBtn.disabled = connected || state.handConnecting
    if (disconnectBtn) disconnectBtn.disabled = !connected
    const sendBtn = document.getElementById('sendCustom')
    if (sendBtn) sendBtn.disabled = !connected
    for (const button of document.querySelectorAll('[data-preset]')) {
      button.disabled = !connected
    }
    for (const button of document.querySelectorAll('[data-firmware-gesture]')) {
      button.disabled = !connected
    }
  }

  function enqueueCommand(text) {
    const payload = document.getElementById('appendNewline').checked ? `${text}\n` : text
    const withResponse = document.getElementById('writeWithResponse').checked
    state.handQueue = state.handQueue.then(async () => {
      if (!handConnected()) {
        logCommand(`跳过（未连接）: ${text}`)
        return
      }
      const bytes = new TextEncoder().encode(payload)
      try {
        if (withResponse && state.handChar.writeValueWithResponse) {
          await state.handChar.writeValueWithResponse(bytes)
        } else if (!withResponse && state.handChar.writeValueWithoutResponse) {
          await state.handChar.writeValueWithoutResponse(bytes)
        } else {
          await state.handChar.writeValue(bytes)
        }
        logCommand(`发送: ${text}`)
      } catch (err) {
        logCommand(`发送失败: ${text} -> ${err.name || 'Error'}: ${err.message || err}`)
      }
    })
    return state.handQueue
  }

  function sendPreset(name) {
    const angles = PRESET_ANGLES[name]
    if (!angles) {
      logCommand(`未知预设手势: ${name}`)
      return
    }
    if (!document.getElementById('usePresetAngles').checked) {
      enqueueCommand(name)
      return
    }
    angles.forEach((sliderValue, index) => {
      const angle = Math.max(0, Math.min(180, Math.round(sliderValue * 1.8)))
      state.sliderValues[index] = sliderValue
      const slider = document.getElementById(`finger-slider-${index}`)
      const label = document.getElementById(`finger-value-${index}`)
      if (slider) slider.value = String(sliderValue)
      if (label) label.textContent = String(angle)
      enqueueCommand(`servo_${index}=${angle}`)
    })
    logCommand(`预设手势: ${name}`)
  }

  function onFingerSlider(index, rawValue) {
    const sliderValue = Math.max(0, Math.min(100, Math.round(Number(rawValue) || 0)))
    const angle = Math.max(0, Math.min(180, Math.round(sliderValue * 1.8)))
    const label = document.getElementById(`finger-value-${index}`)
    if (label) label.textContent = String(angle)
    // 与桌面上位机一致：变化小于 3 时不重复发送，避免刷 BLE。
    if (Math.abs(sliderValue - state.sliderValues[index]) < 3) return
    state.sliderValues[index] = sliderValue
    if (!handConnected()) return
    enqueueCommand(`servo_${index}=${angle}`)
  }

  function onGestureFrame(gesture) {
    if (!handConnected()) return
    if (!document.getElementById('gestureDriveHand')) return
    if (!document.getElementById('gestureDriveHand').checked) return
    const key = gesture.fingers.join(',')
    if (key === state.lastGestureKey) return
    const now = performance.now()
    if (now - (state.lastGestureSentAt || 0) < GESTURE_MIN_INTERVAL_MS) return
    state.lastGestureKey = key
    state.lastGestureSentAt = now
    gesture.fingers.forEach((up, index) => {
      const angle = up === 1 ? 0 : 180
      enqueueCommand(`servo_${index}=${angle}`)
    })
    logCommand(`手势驱动: ${gesture.name}`)
  }

  async function connectHand() {
    if (!('bluetooth' in navigator)) {
      setHandStatus('当前浏览器没有 Web Bluetooth，iOS 请使用 Bluefy')
      return
    }
    const name = (document.getElementById('deviceNameInput').value || '').trim()
    state.handConnecting = true
    updateHandUi()
    setHandStatus('正在请求设备...')
    try {
      const filters = name ? [{ name }] : undefined
      const device = await navigator.bluetooth.requestDevice(
        filters
          ? { filters, optionalServices: [HAND_SERVICE_UUID] }
          : { acceptAllDevices: true, optionalServices: [HAND_SERVICE_UUID] }
      )
      state.handDevice = device
      device.addEventListener('gattserverdisconnected', () => {
        state.handServer = null
        state.handChar = null
        state.lastGestureKey = ''
        setHandStatus(`已断开: ${device.name || device.id}`)
        logCommand('机械手连接已断开')
        updateHandUi()
      })
      setHandStatus(`正在连接 ${device.name || device.id} ...`)
      const server = await device.gatt.connect()
      state.handServer = server
      const service = await server.getPrimaryService(HAND_SERVICE_UUID)
      const characteristic = await service.getCharacteristic(HAND_WRITE_CHAR_UUID)
      state.handChar = characteristic
      state.handQueue = Promise.resolve()
      state.lastGestureKey = ''
      setHandStatus(`已连接 ${device.name || device.id}，写特征就绪`)
      logCommand(`已连接 ${device.name || device.id}`)
    } catch (err) {
      state.handServer = null
      state.handChar = null
      setHandStatus(`连接失败: ${err.name || 'Error'}: ${err.message || err}`)
      logCommand(`连接失败: ${err.message || err}`)
    } finally {
      state.handConnecting = false
      updateHandUi()
    }
  }

  async function disconnectHand() {
    try {
      if (state.handServer && state.handServer.connected) {
        state.handServer.disconnect()
      }
    } catch (err) {
      logCommand(`断开异常: ${err.message || err}`)
    }
    state.handServer = null
    state.handChar = null
    state.lastGestureKey = ''
    setHandStatus('未连接')
    updateHandUi()
  }

  function buildControlPanel() {
    const presetWrap = document.getElementById('presetButtons')
    if (presetWrap) {
      presetWrap.innerHTML = ''
      for (const name of QUICK_MESSAGES) {
        const button = document.createElement('button')
        button.type = 'button'
        button.dataset.preset = name
        button.textContent = name
        button.disabled = true
        button.addEventListener('click', () => sendPreset(name))
        presetWrap.appendChild(button)
      }
    }

    const sliderWrap = document.getElementById('fingerSliders')
    if (sliderWrap) {
      sliderWrap.innerHTML = ''
      FINGER_LABELS.forEach((label, index) => {
        const row = document.createElement('div')
        row.className = 'rh-slider-row'

        const name = document.createElement('span')
        name.textContent = label

        const slider = document.createElement('input')
        slider.type = 'range'
        slider.min = '0'
        slider.max = '100'
        slider.step = '1'
        slider.value = '0'
        slider.id = `finger-slider-${index}`
        slider.addEventListener('input', (event) => onFingerSlider(index, event.target.value))

        const value = document.createElement('span')
        value.id = `finger-value-${index}`
        value.textContent = '0'

        row.appendChild(name)
        row.appendChild(slider)
        row.appendChild(value)
        sliderWrap.appendChild(row)
      })
    }
  }

  function buildReport() {
    const info = detectPlatform()
    return JSON.stringify({
      timestamp: new Date().toISOString(),
      page: location.href,
      platform: info,
      modelUrl: MODEL_PATH,
      mediapipe: CDN_BASE,
      hand: {
        serviceUuid: HAND_SERVICE_UUID,
        writeCharUuid: HAND_WRITE_CHAR_UUID,
        connected: handConnected(),
        deviceName: state.handDevice ? state.handDevice.name || state.handDevice.id : '',
        writeWithResponse: Boolean(
          document.getElementById('writeWithResponse') &&
            document.getElementById('writeWithResponse').checked
        ),
        appendNewline: Boolean(
          document.getElementById('appendNewline') &&
            document.getElementById('appendNewline').checked
        )
      },
      results: TESTS.map((t) => ({
        id: t.id,
        name: t.name,
        group: t.group,
        status: t.status || 'pending',
        expected: t.expected,
        actual: t.actual || '',
        errorName: t.errorName || '',
        errorMessage: t.errorMessage || '',
        suggestion: t.suggestion || ''
      }))
    }, null, 2)
  }

  function updateSummary() {
    const counts = {
      pass: 0,
      warn: 0,
      fail: 0,
      pending: 0,
      running: 0
    }
    for (const t of TESTS) {
      const key = t.status || 'pending'
      if (key in counts) counts[key]++
    }
    const el = document.getElementById('summary')
    if (counts.fail) {
      el.textContent = `失败 ${counts.fail} 项，警告 ${counts.warn} 项，通过 ${counts.pass} 项，未完成 ${counts.pending + counts.running} 项`
    } else if (counts.warn) {
      el.textContent = `通过 ${counts.pass} 项，警告 ${counts.warn} 项，未完成 ${counts.pending + counts.running} 项`
    } else {
      el.textContent = `通过 ${counts.pass} 项，警告 ${counts.warn} 项，未完成 ${counts.pending + counts.running} 项`
    }
  }

  async function copyReport() {
    const text = buildReport()
    try {
      await navigator.clipboard.writeText(text)
      document.getElementById('summary').textContent = '测试报告已复制到剪贴板'
    } catch (err) {
      const area = document.createElement('textarea')
      area.value = text
      document.body.appendChild(area)
      area.select()
      document.execCommand('copy')
      area.remove()
      document.getElementById('summary').textContent = '测试报告已复制'
    }
  }

  function downloadReport() {
    const blob = new Blob([buildReport()], { type: 'application/json' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `robothand-test-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}.json`
    a.click()
    URL.revokeObjectURL(url)
  }

  document.getElementById('runAuto').addEventListener('click', runAutoTests)
  document.getElementById('copyReport').addEventListener('click', copyReport)
  document.getElementById('downloadReport').addEventListener('click', downloadReport)
  document.getElementById('clearModelCache').addEventListener('click', async () => {
    const ok = await clearModelCache()
    state.modelBuffer = null
    document.getElementById('summary').textContent = ok
      ? '已清除本地模型缓存，下次加载会重新下载'
      : '清除模型缓存失败或当前浏览器不支持 indexedDB'
  })
  document.getElementById('stopGesture').addEventListener('click', () => stopGestureDetection())
  document.getElementById('minimizeCamera').addEventListener('click', toggleCameraMinimized)
  document.getElementById('closeCamera').addEventListener('click', closeCameraPanel)
  setupCameraDrag()

  document.getElementById('connectHand').addEventListener('click', connectHand)
  document.getElementById('disconnectHand').addEventListener('click', disconnectHand)
  document.getElementById('sendCustom').addEventListener('click', () => {
    const input = document.getElementById('customCommand')
    const text = (input.value || '').trim()
    if (!text) return
    enqueueCommand(text)
  })
  document.getElementById('customCommand').addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault()
      document.getElementById('sendCustom').click()
    }
  })
  document.getElementById('clearLog').addEventListener('click', () => {
    document.getElementById('commandLog').textContent = '暂无指令'
  })

  buildControlPanel()
  updateHandUi()

  window.addEventListener('resize', () => {
    const panel = document.getElementById('camera-preview')
    if (!panel || panel.hidden || !panel.style.left) return
    const maxLeft = Math.max(6, window.innerWidth - panel.offsetWidth - 6)
    const maxTop = Math.max(6, window.innerHeight - 48)
    const left = parseFloat(panel.style.left) || 0
    const top = parseFloat(panel.style.top) || 0
    panel.style.left = `${Math.min(maxLeft, Math.max(6, left))}px`
    panel.style.top = `${Math.min(maxTop, Math.max(6, top))}px`
  })

  renderTests()
  updateSummary()

  window.addEventListener('beforeunload', () => {
    stopCamera()
    if (state.bleServer && state.bleServer.connected) {
      state.bleServer.disconnect().catch(() => {})
    }
    if (state.handServer && state.handServer.connected) {
      try {
        state.handServer.disconnect()
      } catch (err) {
        // 页面即将卸载，忽略断开异常。
      }
    }
  })
</script>
