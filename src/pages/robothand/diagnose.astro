---
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  title: '机械手环境测试',
  description: '逐步检测摄像头、MediaPipe 手势识别、Web Bluetooth 和 BLE 设备连接能力'
}
---

<PageLayout {meta}>
  <main class="rh-test">
    <section class="rh-hero">
      <h1>机械手环境测试</h1>
      <p>这个页面按步骤检查当前浏览器能否完成摄像头、手势识别、蓝牙发现与 BLE 连接。每步都会记录通过、警告、失败和错误详情。</p>
      <div class="rh-actions">
        <button id="runAuto" type="button">自动环境检测</button>
        <button id="copyReport" type="button">复制测试报告</button>
        <button id="downloadReport" type="button">下载 JSON 报告</button>
        <button id="clearModelCache" type="button">清除模型缓存</button>
      </div>
      <div id="summary" class="rh-summary">等待检测</div>
      <div id="model-loading" class="rh-loading" hidden>
        <div id="model-loading-text">正在加载手部模型</div>
        <div class="rh-progress"><div id="model-progress-bar"></div></div>
      </div>
    </section>

    <section class="rh-preview" id="camera-preview" hidden>
      <div class="rh-preview-header" id="cameraDragHandle">
        <h2>摄像头预览</h2>
        <div class="rh-preview-header-actions">
          <button id="minimizeCamera" type="button">收起</button>
          <button id="closeCamera" type="button">关闭</button>
        </div>
      </div>
      <div id="camera-body">
        <div class="rh-preview-box">
          <video id="camera-video" autoplay muted playsinline></video>
          <canvas id="gesture-canvas"></canvas>
        </div>
        <p id="gesture-status">未开始识别</p>
        <p id="gesture-debug" class="rh-debug">调试: 未启动</p>
        <label class="rh-inline-check">
          <input id="gestureDriveHand" type="checkbox" /> 用手势驱动机械手
        </label>
        <div class="rh-actions">
          <button id="stopGesture" type="button" hidden>停止手势识别</button>
        </div>
      </div>
    </section>

    <section id="tests" class="rh-tests" aria-live="polite"></section>

    <section class="rh-control" id="control-panel">
      <h2>机械手指令测试</h2>
      <p class="rh-control-hint">
        以下按键与桌面上位机保持一致：预设手势会按 PRESET_ANGLES 依次发送 5 条
        <code>servo_i=angle</code>，也可以单独发送固件内置手势名或自定义文本。
      </p>

      <div class="rh-field">
        <label for="deviceNameInput">设备名</label>
        <input id="deviceNameInput" type="text" value="robhand" autocomplete="off" spellcheck="false" />
      </div>

      <div class="rh-field-row">
        <label><input id="writeWithResponse" type="checkbox" /> 写入等待响应</label>
        <label><input id="appendNewline" type="checkbox" /> 命令追加换行</label>
        <label><input id="usePresetAngles" type="checkbox" checked /> 预设手势发送 servo 角度</label>
      </div>

      <div class="rh-actions">
        <button id="connectHand" type="button">连接机械手</button>
        <button id="disconnectHand" type="button" disabled>断开连接</button>
      </div>
      <div id="handStatus" class="rh-summary">未连接</div>

      <h3>预设手势</h3>
      <div id="presetButtons" class="rh-grid"></div>

      <h3>五指滑块（0-100 映射到 0-180 度）</h3>
      <div id="fingerSliders" class="rh-sliders"></div>

      <h3>自定义命令</h3>
      <div class="rh-actions">
        <input id="customCommand" type="text" placeholder="例如 servo_0=90 或 fist" autocomplete="off" spellcheck="false" />
        <button id="sendCustom" type="button" disabled>发送</button>
      </div>

      <h3>指令日志</h3>
      <div class="rh-actions">
        <button id="clearLog" type="button">清空日志</button>
      </div>
      <pre id="commandLog" class="rh-log">暂无指令</pre>
    </section>
  </main>
</PageLayout>

<style is:global>
  .rh-test {
    margin: 0 auto;
    max-width: 860px;
    padding: 24px 0 40px;
  }

  .rh-hero {
    margin-bottom: 22px;
  }

  .rh-hero h1 {
    margin: 0 0 8px;
    font-size: 26px;
    line-height: 1.3;
  }

  .rh-hero p {
    margin: 0 0 14px;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
  }

  .rh-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rh-actions button,
  .rh-action-btn {
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    padding: 9px 14px;
    font-size: 14px;
    cursor: pointer;
    line-height: 1.2;
  }

  .rh-actions button:hover,
  .rh-action-btn:hover {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
  }

  .rh-actions button:disabled,
  .rh-action-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .rh-summary {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    font-size: 14px;
  }

  .rh-loading {
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--card));
  }

  .rh-loading div:first-child {
    margin-bottom: 8px;
    font-size: 13px;
  }

  .rh-progress {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: hsl(var(--muted));
  }

  #model-progress-bar {
    width: 0%;
    height: 100%;
    border-radius: 999px;
    background: hsl(var(--primary));
    transition: width 0.2s ease;
  }

  .rh-preview {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    width: min(280px, calc(100vw - 28px));
    padding: 8px 10px;
    border: 1px solid hsl(var(--border));
    border-radius: 10px;
    background: hsl(var(--card));
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
  }

  .rh-preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: grab;
    touch-action: none;
    user-select: none;
    margin-bottom: 8px;
  }

  .rh-preview-header:active {
    cursor: grabbing;
  }

  .rh-preview-header h2 {
    margin: 0;
    font-size: 14px;
  }

  .rh-preview-header-actions {
    display: flex;
    gap: 6px;
  }

  .rh-preview-header-actions button {
    padding: 4px 8px;
    font-size: 12px;
  }

  .rh-preview.rh-preview--minimized {
    width: min(190px, calc(100vw - 20px));
  }

  .rh-preview--minimized #camera-body {
    display: none;
  }

  .rh-preview-box {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: #111;
  }

  #camera-video,
  #gesture-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
  }

  #camera-video {
    z-index: 1;
    pointer-events: none;
  }

  #gesture-canvas {
    z-index: 2;
    pointer-events: none;
    background: transparent;
  }

  #gesture-status {
    margin: 10px 0 0;
    font-size: 14px;
  }

  .rh-debug {
    margin: 4px 0 0;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .rh-inline-check {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 12px;
  }

  .rh-tests {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rh-control {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid hsl(var(--border));
  }

  .rh-control h2 {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .rh-control h3 {
    margin: 18px 0 8px;
    font-size: 14px;
  }

  .rh-control-hint {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
  }

  .rh-field {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .rh-field label {
    flex: 0 0 auto;
    font-size: 13px;
  }

  .rh-field input[type='text'],
  .rh-control input[type='text'] {
    flex: 1 1 auto;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 14px;
  }

  .rh-field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 12px;
    font-size: 13px;
  }

  .rh-field-row label {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .rh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
  }

  .rh-grid button {
    padding: 10px 8px;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    font-size: 14px;
    cursor: pointer;
  }

  .rh-grid button:hover:not(:disabled) {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
  }

  .rh-grid button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .rh-sliders {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rh-slider-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .rh-slider-row span:first-child {
    flex: 0 0 56px;
    font-size: 13px;
  }

  .rh-slider-row input[type='range'] {
    flex: 1 1 auto;
    min-width: 0;
  }

  .rh-slider-row span:last-child {
    flex: 0 0 46px;
    text-align: right;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .rh-log {
    max-height: 220px;
    margin: 0;
    padding: 10px 12px;
    overflow: auto;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--card));
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 12px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .rh-test-row {
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--card));
    padding: 12px 14px;
  }

  .rh-test-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .rh-test-title {
    margin: 0;
    font-size: 15px;
    line-height: 1.4;
  }

  .rh-test-meta {
    margin: 3px 0 0;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }

  .rh-status {
    flex: 0 0 auto;
    min-width: 64px;
    text-align: center;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }

  .rh-status.pending { background: hsl(var(--muted)); color: hsl(var(--muted-foreground)); }
  .rh-status.running { background: hsl(var(--primary) / 0.16); color: hsl(var(--primary)); }
  .rh-status.pass { background: hsl(142 70% 45% / 0.16); color: hsl(142 70% 35%); }
  .rh-status.warn { background: hsl(38 92% 50% / 0.16); color: hsl(38 92% 35%); }
  .rh-status.fail { background: hsl(0 84% 60% / 0.14); color: hsl(0 84% 48%); }
  .rh-status.skip { background: hsl(var(--muted)); color: hsl(var(--muted-foreground)); }

  .rh-test-detail {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
    word-break: break-word;
  }

  .rh-error {
    margin: 10px 0 0;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid hsl(0 84% 60% / 0.35);
    background: hsl(0 84% 60% / 0.06);
    font-size: 12px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .rh-error strong {
    display: block;
    margin-bottom: 4px;
  }

  .rh-action-row {
    margin-top: 10px;
  }

  @media (max-width: 640px) {
    .rh-hero h1 {
      font-size: 22px;
    }

    .rh-actions {
      flex-direction: column;
    }

    .rh-actions button {
      width: 100%;
    }

    .rh-test-head {
      flex-direction: column;
    }

    .rh-preview {
      width: min(230px, calc(100vw - 20px));
      padding: 6px 8px;
    }

    .rh-preview-header h2 {
      font-size: 12px;
    }

    .rh-preview-header-actions button {
      padding: 3px 6px;
      font-size: 11px;
    }

    .rh-debug {
      font-size: 10px;
    }
  }
</style>

<script is:inline type="module">
  const MODEL_PATH = '/robothand/hand_landmarker.task'
  const MODEL_GZ_PATH = '/robothand/hand_landmarker.task.gz'
  const CDN_BASE = 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1'
  const HAND_CONNECTIONS = [
    [0, 1], [1, 2], [2, 3], [3, 4],
    [0, 5], [5, 6], [6, 7], [7, 8],
    [0, 9], [9, 10], [10, 11], [11, 12],
    [0, 13], [13, 14], [14, 15], [15, 16],
    [0, 17], [17, 18], [18, 19], [19, 20]
  ]
  const COMMON_SERVICES = [
    '00001800-0000-1000-8000-00805f9b34fb',
    '00001801-0000-1000-8000-00805f9b34fb',
    '0000180a-0000-1000-8000-00805f9b34fb',
    '0000180d-0000-1000-8000-00805f9b34fb',
    '0000180f-0000-1000-8000-00805f9b34fb'
  ]

  // 与 ESP32 固件和桌面上位机保持一致的协议常量。
  const HAND_SERVICE_UUID = '89d60870-9908-4472-8f8c-e5b3e6573cd1'
  const HAND_WRITE_CHAR_UUID = '39dea685-a63e-44b2-8819-9a202581f8fe'
  const FINGER_LABELS = ['拇指', '食指', '中指', '无名指', '小指']
  const QUICK_MESSAGES = [
    'five', 'four', 'three', 'two', 'one',
    'ok', 'rock', 'love', 'fist', 'scratch', 'come'
  ]
  const PRESET_ANGLES = {
    five: [0, 0, 0, 0, 0],
    four: [100, 0, 0, 0, 0],
    three: [100, 0, 0, 0, 100],
    two: [100, 0, 0, 100, 100],
    one: [100, 0, 100, 100, 100],
    ok: [0, 100, 100, 100, 100],
    rock: [100, 0, 100, 100, 0],
    love: [0, 0, 100, 100, 0],
    fist: [100, 100, 100, 100, 100],
    scratch: [0, 100, 0, 0, 0],
    come: [0, 0, 100, 0, 0]
  }
  const GESTURE_MIN_INTERVAL_MS = 60
  const DETECT_INTERVAL_MS = 55
  const MODEL_CACHE_DB = 'robothand-model-cache'
  const MODEL_CACHE_STORE = 'models'
  const MODEL_CACHE_KEY = 'hand_landmarker.task'

  const state = {
    cameraStream: null,
    modelBuffer: null,
    landmarker: null,
    bleDevice: null,
    bleServer: null,
    bleServices: [],
    gestureRaf: 0,
    gestureRunning: false,
    gestureSeen: false,
    gestureFrames: 0,
    gestureHandFrames: 0,
    gestureLastDebug: 0,
    cameraMinimized: false,
    gestureLastDetect: 0,
    gestureTimestamp: 0,
    handDevice: null,
    handServer: null,
    handChar: null,
    handQueue: Promise.resolve(),
    handConnecting: false,
    sliderValues: [0, 0, 0, 0, 0],
    lastGestureKey: '',
    lastGestureSentAt: 0,
    busy: false
  }

  const TESTS = [
    {
      id: 'secure-context',
      name: '安全上下文',
      group: '环境',
      auto: true,
      expected: '页面运行在 HTTPS 或 localhost',
      run: async () => {
        const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)
        const ok = window.isSecureContext && (location.protocol === 'https:' || local)
        const lanIp = /^(\d{1,3}\.){3}\d{1,3}$/.test(location.hostname)
        return {
          status: ok ? 'pass' : 'fail',
          actual: ok ? `${location.origin} 安全上下文正常` : `${location.href} 不是安全上下文`,
          suggestion: ok
            ? ''
            : lanIp
              ? '安卓手机通过局域网 IP 访问时必须使用 HTTPS；请部署到 Cloudflare Pages，或使用 HTTPS 隧道访问。'
              : '请通过 HTTPS 部署到 Cloudflare Pages，或使用 localhost 调试。'
        }
      }
    },
    {
      id: 'platform',
      name: '浏览器与平台识别',
      group: '环境',
      auto: true,
      expected: '能识别当前浏览器和操作系统',
      run: async () => {
        const info = detectPlatform()
        return { status: 'pass', actual: `${info.browser} / ${info.os}` }
      }
    },
    {
      id: 'bluetooth-api',
      name: 'Web Bluetooth API',
      group: '蓝牙',
      auto: true,
      expected: 'navigator.bluetooth 存在',
      run: async () => {
        if (!('bluetooth' in navigator)) {
          if (!window.isSecureContext) {
            return {
              status: 'fail',
              actual: '非安全上下文，Web Bluetooth 被浏览器禁用',
              suggestion: '请使用 HTTPS 或 localhost 访问，例如先部署到 Cloudflare Pages。'
            }
          }
          const info = detectPlatform()
          if (info.ios) {
            return {
              status: 'warn',
              actual: '当前为 iOS Safari，没有 Web Bluetooth',
              suggestion: '请复制本页链接，在 Bluefy 中打开后重新测试。'
            }
          }
          throw new Error('当前浏览器不支持 Web Bluetooth API')
        }
        return { status: 'pass', actual: 'navigator.bluetooth 可用' }
      }
    },
    {
      id: 'media-devices',
      name: '摄像头 API',
      group: '摄像头',
      auto: true,
      expected: 'navigator.mediaDevices.getUserMedia 存在',
      run: async () => {
        if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== 'function') {
          if (!window.isSecureContext) {
            return {
              status: 'fail',
              actual: '非安全上下文，getUserMedia 被浏览器禁用',
              suggestion: '请使用 HTTPS 或 localhost 访问，例如先部署到 Cloudflare Pages。'
            }
          }
          throw new Error('getUserMedia 不存在')
        }
        return { status: 'pass', actual: 'navigator.mediaDevices.getUserMedia 可用' }
      }
    },
    {
      id: 'wasm',
      name: 'WebAssembly',
      group: '运行环境',
      auto: true,
      expected: 'WebAssembly 可以实例化',
      run: async () => {
        if (typeof WebAssembly === 'undefined') {
          throw new Error('当前浏览器没有 WebAssembly')
        }
        await WebAssembly.instantiate(new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0]))
        return { status: 'pass', actual: 'WebAssembly 可用' }
      }
    },
    {
      id: 'webgl',
      name: 'WebGL',
      group: '运行环境',
      auto: true,
      expected: 'WebGL2 或 WebGL1 可用',
      run: async () => {
        const canvas = document.createElement('canvas')
        const gl2 = canvas.getContext('webgl2')
        const gl1 = canvas.getContext('webgl') || canvas.getContext('experimental-webgl')
        if (gl2) return { status: 'pass', actual: 'WebGL2 可用' }
        if (gl1) return { status: 'warn', actual: '仅 WebGL1 可用，MediaPipe 可能降低画质', suggestion: '建议使用较新的 Chrome/Edge 或 iOS 系统版本。' }
        throw new Error('WebGL 不可用')
      }
    },
    {
      id: 'bluefy-extras',
      name: 'Bluefy / 浏览器扩展能力',
      group: '环境',
      auto: true,
      expected: '检测 Bluefy 提供的扩展接口',
      run: async () => {
        const found = []
        const bt = navigator.bluetooth
        if (bt && typeof bt.getDevices === 'function') found.push('getDevices')
        if (bt && typeof bt.setScreenDimEnabled === 'function') found.push('setScreenDimEnabled')
        if (window.BLENative && typeof window.BLENative.notifyAppState === 'function') found.push('BLENative.notifyAppState')
        if (!found.length) {
          const info = detectPlatform()
          if (info.ios && !('bluetooth' in navigator)) {
            return { status: 'warn', actual: '未发现 Bluefy 扩展', suggestion: 'iPhone 请在 Bluefy 中打开以启用 Web Bluetooth。' }
          }
          return { status: 'pass', actual: '无 Bluefy 扩展，符合普通 Chrome/Edge 行为' }
        }
        return { status: 'pass', actual: found.join(', ') }
      }
    },
    {
      id: 'camera-open',
      name: '打开摄像头',
      group: '摄像头',
      auto: false,
      interactive: true,
      actionLabel: '打开摄像头',
      expected: '能打开前置摄像头并显示视频流',
      run: async () => {
        await stopCamera()
        let stream
        try {
