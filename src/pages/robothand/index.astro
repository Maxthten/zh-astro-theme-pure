---
// 正式机械手控制页。独立页面，不继承博客布局。
// 协议常量、预设手势、滑块逻辑与 diagnose.astro 保持一致。
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>机械手控制</title>
    <!-- 必须用 is:global：滑块行、预设按钮等元素由 JS 动态创建，
         不会带 Astro 作用域类，普通 <style> 会导致这些样式全部失效。 -->
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #07080d;
        --bg-grid: rgba(0, 240, 255, 0.05);
        --card: rgba(13, 17, 28, 0.82);
        --card-solid: #0d111c;
        --text: #dff6ff;
        --muted: #6f8ba3;
        --border: rgba(0, 240, 255, 0.22);
        --border-strong: rgba(0, 240, 255, 0.5);
        --primary: #00f0ff;
        --accent: #fcee0a;
        --magenta: #ff2e88;
        --danger: #ff3b50;
        --ok: #4bffa5;
        --warn: #fcee0a;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100dvh;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC',
          'Microsoft YaHei', sans-serif;
        -webkit-tap-highlight-color: transparent;
        /* 全页禁止选中文本：避免拖动滑块时误选文字 */
        -webkit-user-select: none;
        user-select: none;
      }

      /* 仅输入框和日志允许选中，方便复制命令与排查 */
      input,
      textarea,
      .rh-log {
        -webkit-user-select: text;
        user-select: text;
      }

      /* 赛博朋克背景：扫描网格 + 双色光斑 */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -2;
        background:
          radial-gradient(circle at 12% 8%, rgba(255, 46, 136, 0.16), transparent 42%),
          radial-gradient(circle at 88% 92%, rgba(0, 240, 255, 0.14), transparent 45%),
          var(--bg);
      }

      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image:
          linear-gradient(var(--bg-grid) 1px, transparent 1px),
          linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
        background-size: 44px 44px;
      }

      button,
      input {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      button:disabled,
      input:disabled {
        cursor: not-allowed;
      }

      .page {
        width: min(100%, 960px);
        margin: 0 auto;
        padding: 18px 16px 36px;
      }

      .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
      }

      .page-header h1 {
        margin: 0;
        font-size: 25px;
        line-height: 1.25;
        letter-spacing: 0;
        text-transform: uppercase;
        color: var(--primary);
        text-shadow: 0 0 12px rgba(0, 240, 255, 0.45);
      }

      .page-header p {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
      }

      .diagnose-link {
        flex: 0 0 auto;
        display: inline-block;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 2px;
        color: var(--muted);
        text-decoration: none;
        font-size: 13px;
      }

      .diagnose-link:hover {
        border-color: var(--border-strong);
        color: var(--primary);
      }

      .status-banner {
        margin-bottom: 14px;
        padding: 13px 15px;
        border: 1px solid var(--border);
        border-left: 3px solid var(--primary);
        border-radius: 2px;
        background: var(--card);
        font-size: 14px;
        line-height: 1.6;
        backdrop-filter: blur(6px);
      }

      .status-banner[data-kind='ready'] {
        border-left-color: var(--ok);
      }

      .status-banner[data-kind='warn'] {
        border-left-color: var(--warn);
      }

      .status-banner[data-kind='error'] {
        border-left-color: var(--danger);
      }

      .status-title {
        margin-bottom: 6px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--primary);
      }

      .progress-list {
        margin: 10px 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 6px;
        font-size: 13px;
        color: var(--muted);
      }

      .progress-list li[data-state='done'] {
        color: var(--ok);
      }

      .progress-list li[data-state='error'] {
        color: var(--danger);
      }

      .progress-list li[data-state='active'] {
        color: var(--primary);
      }

      .progress-track {
        height: 4px;
        margin-top: 10px;
        overflow: hidden;
        background: rgba(0, 240, 255, 0.12);
      }

      .progress-track > div {
        width: 0;
        height: 100%;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        box-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
        transition: width 0.25s ease;
      }

      .section {
        margin-top: 14px;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: var(--card);
        backdrop-filter: blur(6px);
      }

      .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .section-title {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--primary);
      }

      /* 标题前的赛博装饰条 */
      .section-title::before {
        content: '';
        display: inline-block;
        width: 3px;
        height: 12px;
        margin-right: 8px;
        vertical-align: -1px;
        background: var(--magenta);
        box-shadow: 0 0 8px var(--magenta);
      }

      .disable-reason {
        margin: 8px 0 0;
        color: var(--warn);
        font-size: 12px;
        line-height: 1.5;
      }

      .disable-reason[hidden] {
        display: none;
      }

      .row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
      }

      .field {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1 1 260px;
      }

      .field label {
        flex: 0 0 auto;
        font-size: 13px;
        color: var(--muted);
      }

      .field input[type='text'] {
        flex: 1 1 auto;
        min-width: 0;
        padding: 9px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
      }

      .btn {
        min-height: 40px;
        padding: 9px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font-size: 14px;
      }

      .btn-primary {
        border-color: var(--primary);
        color: var(--primary);
      }

      .btn:disabled {
        opacity: 0.42;
      }

      input[type='range'] {
        width: 100%;
        accent-color: var(--primary);
      }

      #camera-video,
      #gesture-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scaleX(-1);
      }

      #gesture-canvas {
        pointer-events: none;
      }

      #gestureStatus {
        margin: 10px 0 0;
        font-size: 13px;
        color: var(--muted);
      }

      .rh-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .rh-actions button,
      .rh-action-btn {
        min-height: 42px;
        border: 1px solid var(--border-strong);
        border-radius: 2px;
        background: rgba(0, 240, 255, 0.06);
        color: var(--text);
        padding: 9px 14px;
        font-size: 14px;
        cursor: pointer;
        line-height: 1.2;
        text-transform: uppercase;
        transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .rh-actions button:hover:not(:disabled),
      .rh-action-btn:hover:not(:disabled) {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(0, 240, 255, 0.14);
        box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
      }

      .rh-actions button:disabled,
      .rh-action-btn:disabled {
        opacity: 0.32;
        border-color: var(--border);
        background: transparent;
        cursor: not-allowed;
      }

      .rh-actions input[type='text'] {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 42px;
        padding: 9px 11px;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: rgba(0, 0, 0, 0.35);
        color: var(--text);
        font-size: 14px;
      }

      .rh-actions input[type='text']:focus,
      .rh-field input[type='text']:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 10px rgba(0, 240, 255, 0.25);
      }

      .rh-field {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
      }

      .rh-field label {
        flex: 0 0 auto;
        font-size: 13px;
      }

      .rh-field input[type='text'] {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 42px;
        padding: 9px 11px;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: rgba(0, 0, 0, 0.35);
        color: var(--text);
        font-size: 14px;
        letter-spacing: 0;
      }

      .rh-field-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 12px;
        font-size: 13px;
      }

      .rh-field-row label {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .rh-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
        gap: 8px;
      }

      .rh-grid button {
        min-height: 46px;
        padding: 10px 8px;
        border: 1px solid var(--border-strong);
        border-radius: 2px;
        background: rgba(255, 46, 136, 0.07);
        color: var(--text);
        font-size: 14px;
        cursor: pointer;
        text-transform: uppercase;
        transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .rh-grid button:hover:not(:disabled) {
        border-color: var(--magenta);
        color: var(--magenta);
        background: rgba(255, 46, 136, 0.16);
        box-shadow: 0 0 12px rgba(255, 46, 136, 0.3);
      }

      /* 按下瞬间的物理反馈 */
      .rh-grid button:active:not(:disabled) {
        transform: translateY(1px);
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(252, 238, 10, 0.2);
        box-shadow: 0 0 16px rgba(252, 238, 10, 0.45);
      }

      /* 发送成功后的短暂闪光 */
      .rh-grid button.is-fired {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(252, 238, 10, 0.18);
        box-shadow: 0 0 14px rgba(252, 238, 10, 0.4);
      }

      /* 当前生效的手势保持高亮 */
      .rh-grid button.is-active {
        border-color: var(--magenta);
        color: var(--magenta);
        background: rgba(255, 46, 136, 0.2);
        box-shadow: inset 0 0 0 1px rgba(255, 46, 136, 0.4);
      }

      .rh-grid button:disabled {
        opacity: 0.3;
        border-color: var(--border);
        background: transparent;
        cursor: not-allowed;
      }

      .rh-actions button:active:not(:disabled),
      .rh-action-btn:active:not(:disabled) {
        transform: translateY(1px);
        background: rgba(0, 240, 255, 0.2);
      }

      .rh-sliders {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 4px;
      }

      /* 用固定三列栅格保证每行标签、滑轨、数值完全对齐 */
      .rh-slider-row {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr) 52px;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
        border: 1px solid transparent;
        border-left: 2px solid var(--border);
        background: rgba(0, 240, 255, 0.03);
      }

      .rh-slider-row:focus-within {
        border-left-color: var(--primary);
        background: rgba(0, 240, 255, 0.08);
      }

      .rh-slider-row span:first-child {
        font-size: 13px;
        color: var(--muted);
        white-space: nowrap;
      }

      .rh-slider-row input[type='range'] {
        width: 100%;
        margin: 0;
        height: 26px;
        accent-color: var(--primary);
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
      }

      .rh-slider-row input[type='range']::-webkit-slider-runnable-track {
        height: 4px;
        border-radius: 0;
        background: rgba(0, 240, 255, 0.18);
      }

      .rh-slider-row input[type='range']::-moz-range-track {
        height: 4px;
        background: rgba(0, 240, 255, 0.18);
      }

      .rh-slider-row input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 14px;
        height: 18px;
        margin-top: -7px;
        border: none;
        border-radius: 1px;
        background: var(--primary);
        box-shadow: 0 0 8px rgba(0, 240, 255, 0.7);
      }

      .rh-slider-row input[type='range']::-moz-range-thumb {
        width: 14px;
        height: 18px;
        border: none;
        border-radius: 1px;
        background: var(--primary);
        box-shadow: 0 0 8px rgba(0, 240, 255, 0.7);
      }

      .rh-slider-row input[type='range']:disabled::-webkit-slider-thumb {
        background: var(--muted);
        box-shadow: none;
      }

      .rh-slider-row input[type='range']:disabled::-moz-range-thumb {
        background: var(--muted);
        box-shadow: none;
      }

      .rh-slider-row span:last-child {
        text-align: right;
        font-size: 13px;
        font-variant-numeric: tabular-nums;
        color: var(--primary);
      }

      .rh-log {
        max-height: 220px;
        margin: 12px 0 0;
        padding: 10px 12px;
        overflow: auto;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: rgba(0, 0, 0, 0.45);
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 12px;
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        color: var(--ok);
      }

      .rh-inline-check {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        font-size: 12px;
      }

      .camera-hint {
        margin: 10px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .drive-reason {
        margin: 4px 0 0;
        color: var(--warn);
        font-size: 11px;
        line-height: 1.5;
      }

      .drive-reason:empty {
        display: none;
      }

      .rh-preview {
        position: fixed;
        right: 16px;
        bottom: 16px;
        z-index: 60;
        width: min(var(--preview-w, 280px), calc(100vw - 24px));
        padding: 8px 10px;
        border: 1px solid var(--border-strong);
        border-radius: 2px;
        background: rgba(7, 8, 13, 0.92);
        box-shadow: 0 0 0 1px rgba(255, 46, 136, 0.18), 0 14px 40px rgb(0 0 0 / 0.6);
        backdrop-filter: blur(8px);
      }

      .rh-preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        cursor: grab;
        touch-action: none;
        user-select: none;
        margin-bottom: 8px;
      }

      .rh-preview-header:active {
        cursor: grabbing;
      }

      .rh-preview-header h2 {
        margin: 0;
        font-size: 12px;
        text-transform: uppercase;
        color: var(--primary);
      }

      .rh-preview-header-actions {
        display: flex;
        gap: 6px;
      }

      .rh-preview-header-actions button {
        min-height: 32px;
        padding: 4px 9px;
        font-size: 12px;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: rgba(0, 240, 255, 0.06);
        color: var(--text);
      }

      .rh-preview-header-actions button:hover {
        border-color: var(--primary);
        color: var(--primary);
      }

      .rh-preview.rh-preview--minimized {
        width: min(200px, calc(100vw - 20px));
      }

      .rh-preview--minimized #camera-body {
        display: none;
      }

      .rh-preview-box {
        position: relative;
        overflow: hidden;
        width: 100%;
        aspect-ratio: var(--preview-ratio, 4 / 3);
        border-radius: 2px;
        border: 1px solid var(--border);
        background: #05060a;
      }

      /* 摄像头方向：镜像开关 */
      .rh-preview[data-mirror='off'] #camera-video,
      .rh-preview[data-mirror='off'] #gesture-canvas {
        transform: none;
      }

      .preview-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
      }

      .preview-controls button {
        min-height: 30px;
        padding: 3px 8px;
        border: 1px solid var(--border);
        border-radius: 2px;
        background: transparent;
        color: var(--muted);
        font-size: 11px;
      }

      .preview-controls button[aria-pressed='true'] {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(0, 240, 255, 0.1);
      }

      .unsupported {
        padding: 18px;
        border: 1px solid var(--danger);
        border-radius: 2px;
        background: rgba(255, 59, 80, 0.08);
        line-height: 1.8;
      }

      .unsupported h2 {
        margin: 0 0 8px;
        font-size: 17px;
        text-transform: uppercase;
        color: var(--danger);
      }

      @media (max-width: 640px) {
        .page {
          padding: 12px 10px calc(28px + env(safe-area-inset-bottom));
        }

        .page-header {
          flex-direction: column;
        }

        .page-header h1 {
          font-size: 21px;
        }

        .rh-actions {
          flex-direction: column;
        }

        .rh-actions button,
        .rh-action-btn {
          width: 100%;
        }

        .rh-actions input[type='text'] {
          width: 100%;
          flex: none;
        }

        .rh-field {
          flex-direction: column;
          align-items: stretch;
        }

        .rh-preview {
          width: min(var(--preview-w, 230px), calc(100vw - 20px));
          padding: 6px 8px;
          bottom: calc(12px + env(safe-area-inset-bottom));
          right: 12px;
        }

        .rh-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .rh-slider-row span:first-child {
          font-size: 12px;
        }

        .rh-slider-row {
          grid-template-columns: 52px minmax(0, 1fr) 44px;
          gap: 10px;
          padding: 8px 10px;
        }

        .rh-field-row {
          gap: 10px;
        }

        .rh-preview-header h2 {
          font-size: 12px;
        }

        .rh-preview-header-actions button {
          padding: 3px 6px;
          font-size: 11px;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <div>
          <h1>机械手控制</h1>
          <p>自动检查浏览器环境、模型与连接能力；加载完成前控件会保持锁定。</p>
        </div>
        <a class="diagnose-link" href="/robothand/diagnose">详细诊断页</a>
      </header>

      <section class="status-banner" id="statusBanner" data-kind="active">
        <div class="status-title" id="statusTitle">正在准备环境</div>
        <div id="statusDetail">正在检查安全上下文与浏览器能力。</div>
        <ul class="progress-list" id="progressList"></ul>
        <div class="progress-track"><div id="progressBar"></div></div>
      </section>

      <section class="section" id="connectSection">
        <div class="section-head">
          <h2 class="section-title">连接机械手</h2>
          <span id="connectState">未连接</span>
        </div>
        <p class="disable-reason" id="connectReason" hidden></p>
        <div class="rh-field">
            <label for="deviceName">设备名</label>
            <input id="deviceName" type="text" value="robhand" autocomplete="off" spellcheck="false" />
        </div>
        <div class="rh-actions">
          <button class="rh-action-btn" id="connectBtn" type="button" disabled>连接机械手</button>
          <button class="rh-action-btn" id="disconnectBtn" type="button" disabled>断开连接</button>
        </div>
      </section>

      <section class="section" id="presetSection">
        <div class="section-head">
          <h2 class="section-title">预设手势</h2>
        </div>
        <p class="disable-reason" id="presetReason" hidden></p>
        <div class="rh-field-row">
          <label><input id="usePresetAngles" type="checkbox" checked /> 预设手势发送 servo 角度</label>
          <label><input id="writeWithResponse" type="checkbox" /> 写入等待响应</label>
          <label><input id="appendNewline" type="checkbox" /> 命令追加换行</label>
        </div>
        <div class="rh-grid" id="presetGrid"></div>
      </section>

      <section class="section" id="sliderSection">
        <div class="section-head">
          <h2 class="section-title">五指滑块</h2>
        </div>
        <p class="disable-reason" id="sliderReason" hidden></p>
        <div class="rh-sliders" id="sliderList"></div>
      </section>

      <section class="section" id="cameraSection">
        <div class="section-head">
          <h2 class="section-title">摄像头与手势识别</h2>
        </div>
        <p class="disable-reason" id="cameraReason" hidden></p>
        <div class="rh-actions">
          <button class="rh-action-btn" id="cameraBtn" type="button" disabled>打开摄像头</button>
        </div>
        <p class="camera-hint" id="cameraHint">打开摄像头后，识别与驱动操作都在右下角预览窗内完成。</p>
      </section>

      <section class="rh-preview" id="camera-preview" hidden>
        <div class="rh-preview-header" id="cameraDragHandle">
          <h2>摄像头预览</h2>
          <div class="rh-preview-header-actions">
            <button id="minimizeCamera" type="button">收起</button>
            <button id="closeCamera" type="button">关闭</button>
          </div>
        </div>
        <div id="camera-body">
          <div class="rh-preview-box">
            <video id="camera-video" autoplay muted playsinline></video>
            <canvas id="gesture-canvas"></canvas>
          </div>
          <p id="gestureStatus">摄像头未打开</p>
          <div class="preview-controls" id="previewControls">
            <button id="sizeSmall" type="button" aria-pressed="false">小</button>
            <button id="sizeMedium" type="button" aria-pressed="true">中</button>
            <button id="sizeLarge" type="button" aria-pressed="false">大</button>
            <button id="mirrorToggle" type="button" aria-pressed="true">镜像</button>
            <button id="facingToggle" type="button">前置</button>
          </div>
          <div class="rh-actions">
            <button class="rh-action-btn" id="gestureBtn" type="button" disabled>开始手势识别</button>
            <button class="rh-action-btn" id="stopGestureBtn" type="button" hidden>停止手势识别</button>
          </div>
          <label class="rh-inline-check">
            <input id="gestureDrive" type="checkbox" disabled /> 用手势驱动机械手
          </label>
          <p class="drive-reason" id="driveReason"></p>
        </div>
      </section>

      <section class="section" id="commandSection">
        <div class="section-head">
          <h2 class="section-title">自定义命令与日志</h2>
        </div>
        <p class="disable-reason" id="commandReason" hidden></p>
        <div class="rh-actions">
          <input id="customCommand" type="text" placeholder="例如 servo_0=90 或 fist" autocomplete="off" spellcheck="false" />
          <button class="rh-action-btn" id="sendBtn" type="button" disabled>发送</button>
          <button class="rh-action-btn" id="clearLogBtn" type="button">清空日志</button>
        </div>
        <pre class="rh-log" id="commandLog">暂无指令</pre>
      </section>

      <section class="unsupported" id="unsupportedPanel" hidden>
        <h2>当前浏览器无法使用完整控制</h2>
        <div id="unsupportedText"></div>
      </section>
    </main>

    <script is:inline type="module">
      // 与诊断页保持一致：设备名、UUID、预设手势和发送逻辑。
      const HAND_SERVICE_UUID = '89d60870-9908-4472-8f8c-e5b3e6573cd1'
      const HAND_WRITE_CHAR_UUID = '39dea685-a63e-44b2-8819-9a202581f8fe'
      const MODEL_PATH = '/robothand/hand_landmarker.task'
      const MODEL_GZ_PATH = '/robothand/hand_landmarker.task.gz'
      const CDN_BASE = 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1'
      const MODEL_CACHE_DB = 'robothand-model-cache'
      const MODEL_CACHE_STORE = 'models'
      const MODEL_CACHE_KEY = 'hand_landmarker.task'
      const DETECT_INTERVAL_MS = 55
      const GESTURE_MIN_INTERVAL_MS = 60
      const HAND_CONNECTIONS = [
        [0, 1], [1, 2], [2, 3], [3, 4],
        [0, 5], [5, 6], [6, 7], [7, 8],
        [0, 9], [9, 10], [10, 11], [11, 12],
        [0, 13], [13, 14], [14, 15], [15, 16],
        [0, 17], [17, 18], [18, 19], [19, 20]
      ]
      const FINGER_LABELS = ['拇指', '食指', '中指', '无名指', '小指']
      const QUICK_MESSAGES = [
        'five', 'four', 'three', 'two', 'one',
        'good', 'rock', 'love', 'fist', 'scratch', 'come','ok'
      ]
      const PRESET_ANGLES = {
        five: [0, 0, 0, 0, 0],
        four: [100, 0, 0, 0, 0],
        three: [100, 0, 0, 0, 100],
        two: [100, 0, 0, 100, 100],
        one: [100, 0, 100, 100, 100],
        good: [0, 100, 100, 100, 100],
        rock: [100, 0, 100, 100, 0],
        love: [0, 0, 100, 100, 0],
        fist: [100, 100, 100, 100, 100],
        scratch: [0, 100, 0, 0, 0],
        come: [0, 0, 100, 0, 0],
        ok:[96,87,0,0,0]
      }

      const state = {
        secure: false,
        bluetoothOk: false,
        cameraApiOk: false,
        modelReady: false,
        landmarker: null,
        cameraStream: null,
        cameraOpen: false,
        gestureRunning: false,
        gestureFrames: 0,
        gestureHandFrames: 0,
        gestureLastDetect: 0,
        gestureTimestamp: 0,
        lastGestureKey: '',
        lastGestureSentAt: 0,
        device: null,
        server: null,
        char: null,
        queue: Promise.resolve(),
        connecting: false,
        sliderValues: [0, 0, 0, 0, 0],
        cameraMinimized: false,
        gestureRaf: 0,
        previewSize: 'medium',
        mirrored: true,
        facingMode: 'user',
        wakeLock: null,
        initDone: false
      }

      const statusTitle = document.getElementById('statusTitle')
      const statusDetail = document.getElementById('statusDetail')
      const progressList = document.getElementById('progressList')
      const progressBar = document.getElementById('progressBar')
      const banner = document.getElementById('statusBanner')

      const steps = [
        { id: 'secure', label: '检查安全上下文' },
        { id: 'bluetooth', label: '检查 Web Bluetooth' },
        { id: 'camera', label: '检查摄像头 API' },
        { id: 'model', label: '准备手部模型' },
        { id: 'mediapipe', label: '初始化 MediaPipe' }
      ]

      function stepState(id, value) {
        const item = progressList.querySelector(`[data-step="${id}"]`)
        if (item) item.dataset.state = value
      }

      function setProgress(percent, detail) {
        progressBar.style.width = `${Math.max(0, Math.min(100, percent))}%`
        if (detail) statusDetail.textContent = detail
      }

      function setStatus(title, detail, kind) {
        statusTitle.textContent = title
        if (detail) statusDetail.textContent = detail
        banner.dataset.kind = kind || 'active'
      }

      function logCommand(text) {
        const el = document.getElementById('commandLog')
        if (!el) return
        const stamp = new Date().toLocaleTimeString('zh-CN', { hour12: false })
        const line = `[${stamp}] ${text}`
        el.textContent = el.textContent === '暂无指令' ? line : `${el.textContent}\n${line}`
        el.scrollTop = el.scrollHeight
      }

      function setReason(id, text) {
        const el = document.getElementById(id)
        if (!el) return
        el.hidden = !text
        el.textContent = text || ''
      }

      function connected() {
        return Boolean(state.char && state.server && state.server.connected)
      }

      // 与 diagnose.astro 一致的平台识别，用于 iOS 引导。
      function detectPlatform() {
        const ua = navigator.userAgent || ''
        const ios =
          /iPhone|iPad|iPod/i.test(ua) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
        const android = /Android/i.test(ua)
        let os = 'Windows'
        if (ios) os = 'iOS'
        else if (android) os = 'Android'
        else if (/Mac OS X/i.test(ua)) os = 'macOS'
        else if (/Linux/i.test(ua)) os = 'Linux'

        let browser = '未知浏览器'
        if (/Edg\//i.test(ua)) browser = 'Microsoft Edge'
        else if (/Bluefy/i.test(ua)) browser = 'Bluefy'
        else if (/Chrome\//i.test(ua)) browser = 'Chrome / Chromium'
        else if (/Firefox\//i.test(ua)) browser = 'Firefox'
        else if (/Safari\//i.test(ua)) browser = ios ? 'Safari' : 'Safari'
        return { os, browser, ios, android, ua }
      }

      function updateGates() {
        const canBluetooth = state.secure && state.bluetoothOk
        const canCamera = state.secure && state.cameraApiOk
        const connectBtn = document.getElementById('connectBtn')
        const disconnectBtn = document.getElementById('disconnectBtn')
        const cameraBtn = document.getElementById('cameraBtn')
        const gestureBtn = document.getElementById('gestureBtn')
        const gestureDrive = document.getElementById('gestureDrive')
        const sendBtn = document.getElementById('sendBtn')

        connectBtn.disabled = !canBluetooth || state.connecting || connected()
        disconnectBtn.disabled = !connected()
        cameraBtn.disabled = !canCamera || state.cameraOpen || !state.initDone
        gestureBtn.disabled = !state.cameraOpen || !state.modelReady || state.gestureRunning
        gestureDrive.disabled = !connected() || !state.gestureRunning
        sendBtn.disabled = !connected()

        const deviceName = document.getElementById('deviceName')
        deviceName.disabled = state.connecting || connected()

        for (const button of document.querySelectorAll('[data-preset]')) {
          button.disabled = !connected()
        }

        // 未连接时锁定滑块，避免拖动却无响应造成误解。
        for (const slider of document.querySelectorAll('.rh-slider-row input[type="range"]')) {
          slider.disabled = !connected()
        }

        const customCommand = document.getElementById('customCommand')
        if (customCommand) customCommand.disabled = !connected()

        // 明确说明"用手势驱动"为什么不能勾选
        const driveReason = document.getElementById('driveReason')
        if (driveReason) {
          driveReason.textContent = !connected()
            ? '需要先连接机械手'
            : !state.gestureRunning
              ? '需要先开始手势识别'
              : ''
        }

        setReason(
          'connectReason',
          !state.secure
            ? '页面不是安全上下文，Web Bluetooth 不可用；请通过 HTTPS 访问。'
            : !state.bluetoothOk
              ? '当前浏览器不支持 Web Bluetooth；Windows/Android 请使用 Chrome 或 Edge，iOS 请使用 Bluefy。'
              : state.connecting
                ? '正在请求设备授权，请在系统弹窗中选择机械手。'
                : ''
        )
        setReason(
          'presetReason',
          connected() ? '' : '未连接机械手，连接后即可使用预设手势。'
        )
        setReason(
          'sliderReason',
          connected() ? '' : '未连接机械手，连接后即可拖动五指滑块。'
        )
        setReason(
          'cameraReason',
          !state.secure
            ? '页面不是安全上下文，摄像头不可用；请通过 HTTPS 访问。'
            : !state.cameraApiOk
              ? '当前浏览器不支持摄像头 API。'
              : !state.initDone
                ? '环境检测尚未完成，请稍候。'
                : ''
        )
        setReason(
          'commandReason',
          connected() ? '' : '未连接机械手，连接后即可发送自定义命令。'
        )

        const cameraHint = document.getElementById('cameraHint')
        if (cameraHint) {
          cameraHint.textContent = !state.cameraOpen
            ? '打开摄像头后，识别与驱动操作都在右下角预览窗内完成。'
            : state.gestureRunning
              ? '正在识别中，可在预览窗内停止识别或勾选手势驱动。'
              : '摄像头已打开，请在右下角预览窗内点击“开始手势识别”。'
        }
      }

      function updateConnectState() {
        const el = document.getElementById('connectState')
        if (state.connecting) el.textContent = '连接中'
        else if (connected()) el.textContent = '已连接'
        else el.textContent = '未连接'
      }

      function enqueueCommand(text) {
        const payload = document.getElementById('appendNewline').checked ? `${text}\n` : text
        const withResponse = document.getElementById('writeWithResponse').checked
        state.queue = state.queue.then(async () => {
          if (!connected()) {
            logCommand(`跳过（未连接）: ${text}`)
            return
          }
          const bytes = new TextEncoder().encode(payload)
          try {
            if (withResponse && state.char.writeValueWithResponse) {
              await state.char.writeValueWithResponse(bytes)
            } else if (!withResponse && state.char.writeValueWithoutResponse) {
              await state.char.writeValueWithoutResponse(bytes)
            } else {
              await state.char.writeValue(bytes)
            }
            logCommand(`发送: ${text}`)
          } catch (err) {
            logCommand(`发送失败: ${text} -> ${err.name || 'Error'}: ${err.message || err}`)
          }
        })
        return state.queue
      }

      function sendPreset(name) {
        markPresetFired(name)
        if (!document.getElementById('usePresetAngles').checked) {
          enqueueCommand(name)
          return
        }
        const angles = PRESET_ANGLES[name]
        if (!angles) return
        angles.forEach((sliderValue, index) => {
          const angle = Math.max(0, Math.min(180, Math.round(sliderValue * 1.8)))
          state.sliderValues[index] = sliderValue
          const slider = document.getElementById(`finger-slider-${index}`)
          const label = document.getElementById(`finger-value-${index}`)
          if (slider) slider.value = String(sliderValue)
          if (label) label.textContent = String(angle)
          enqueueCommand(`servo_${index}=${angle}`)
        })
        logCommand(`预设手势: ${name}`)
      }

      // 点击瞬间闪光 + 当前手势保持高亮
      function markPresetFired(name) {
        for (const btn of document.querySelectorAll('[data-preset]')) {
          btn.classList.toggle('is-active', btn.dataset.preset === name)
        }
        const target = document.querySelector(`[data-preset="${name}"]`)
        if (!target) return
        target.classList.add('is-fired')
        setTimeout(() => target.classList.remove('is-fired'), 220)
      }

      function onSlider(index, raw) {
        const value = Math.max(0, Math.min(100, Math.round(Number(raw) || 0)))
        const angle = Math.max(0, Math.min(180, Math.round(value * 1.8)))
        const label = document.getElementById(`finger-value-${index}`)
        if (label) label.textContent = String(angle)
        if (Math.abs(value - state.sliderValues[index]) < 3) return
        state.sliderValues[index] = value
        // 手动调整后，预设手势高亮不再代表当前姿态
        clearPresetActive()
        if (connected()) enqueueCommand(`servo_${index}=${angle}`)
      }

      function clearPresetActive() {
        for (const btn of document.querySelectorAll('[data-preset].is-active')) {
          btn.classList.remove('is-active')
        }
      }

      function buildPanels() {
        const grid = document.getElementById('presetGrid')
        for (const name of QUICK_MESSAGES) {
          const btn = document.createElement('button')
          btn.type = 'button'
          btn.dataset.preset = name
          btn.textContent = name
          btn.disabled = true
          btn.addEventListener('click', () => sendPreset(name))
          grid.appendChild(btn)
        }

        const sliderList = document.getElementById('sliderList')
        FINGER_LABELS.forEach((label, index) => {
          const row = document.createElement('div')
          row.className = 'rh-slider-row'

          const name = document.createElement('span')
          name.textContent = label

          const slider = document.createElement('input')
          slider.type = 'range'
          slider.min = '0'
          slider.max = '100'
          slider.step = '1'
          slider.value = '0'
          slider.id = `finger-slider-${index}`
          slider.addEventListener('input', (e) => onSlider(index, e.target.value))

          const value = document.createElement('span')
          value.id = `finger-value-${index}`
          value.textContent = '0'

          row.append(name, slider, value)
          sliderList.appendChild(row)
        })
      }

      // ---------- 模型与 MediaPipe ----------

      function setModelProgress(text, percent) {
        setProgress(percent, text)
      }

      function fetchWithProgress(url) {
        return new Promise((resolve, reject) => {
          const xhr = new XMLHttpRequest()
          xhr.open('GET', url, true)
          xhr.responseType = 'arraybuffer'
          xhr.onprogress = (event) => {
            if (event.lengthComputable && event.total) {
              const percent = Math.min(100, Math.round((event.loaded / event.total) * 100))
              setModelProgress(
                `正在下载手部模型压缩包（约 ${(event.total / 1048576).toFixed(1)} MB） ${percent}%`,
                percent
              )
            }
          }
          xhr.onload = () => {
            if (xhr.status >= 200 && xhr.status < 300) resolve(xhr.response)
            else reject(new Error(`模型下载失败 HTTP ${xhr.status}`))
          }
          xhr.onerror = () => reject(new Error('模型下载网络错误'))
          xhr.send()
        })
      }

      async function maybeGunzip(payload) {
        const head = new Uint8Array(payload.slice(0, 2))
        if (head[0] !== 0x1f || head[1] !== 0x8b) return payload
        const stream = new Blob([payload]).stream().pipeThrough(new DecompressionStream('gzip'))
        return new Response(stream).arrayBuffer()
      }

      function openCache() {
        return new Promise((resolve, reject) => {
          const request = indexedDB.open(MODEL_CACHE_DB, 1)
          request.onupgradeneeded = () => {
            const db = request.result
            if (!db.objectStoreNames.contains(MODEL_CACHE_STORE)) {
              db.createObjectStore(MODEL_CACHE_STORE)
            }
          }
          request.onsuccess = () => resolve(request.result)
          request.onerror = () => reject(request.error || new Error('缓存不可用'))
        })
      }

      async function readCache() {
        try {
          const db = await openCache()
          return await new Promise((resolve) => {
            const tx = db.transaction(MODEL_CACHE_STORE, 'readonly')
            const req = tx.objectStore(MODEL_CACHE_STORE).get(MODEL_CACHE_KEY)
            req.onsuccess = () => resolve(req.result || null)
            req.onerror = () => resolve(null)
          })
        } catch (err) {
          return null
        }
      }

      async function writeCache(buffer) {
        try {
          const db = await openCache()
          await new Promise((resolve) => {
            const tx = db.transaction(MODEL_CACHE_STORE, 'readwrite')
            tx.objectStore(MODEL_CACHE_STORE).put(buffer, MODEL_CACHE_KEY)
            tx.oncomplete = () => resolve()
            tx.onerror = () => resolve()
          })
        } catch (err) {
          // 缓存失败不影响本次使用。
        }
      }

      async function loadModel() {
        const cached = await readCache()
        if (cached && cached.byteLength >= 1000000) {
          setModelProgress('已从本地缓存读取手部模型', 100)
          return cached
        }

        let buffer = null
        if (typeof DecompressionStream === 'function') {
          try {
            const payload = await fetchWithProgress(MODEL_GZ_PATH)
            buffer = await maybeGunzip(payload)
          } catch (err) {
            buffer = null
          }
        }
        if (!buffer || buffer.byteLength < 1000000) {
          buffer = await fetchWithProgress(MODEL_PATH)
        }
        await writeCache(buffer)
        return buffer
      }

      async function initMediapipe() {
        const buffer = await loadModel()
        stepState('model', 'done')
        setModelProgress('正在初始化 MediaPipe WASM，首次可能需要 10-60 秒', 70)
        const { FilesetResolver, HandLandmarker } = await import(`${CDN_BASE}/vision_bundle.mjs`)
        const vision = await FilesetResolver.forVisionTasks(`${CDN_BASE}/wasm`)
        state.landmarker = await HandLandmarker.createFromOptions(vision, {
          baseOptions: { modelAssetBuffer: new Uint8Array(buffer) },
          runningMode: 'VIDEO',
          numHands: 1,
          minHandDetectionConfidence: 0.7,
          minTrackingConfidence: 0.5
        })
        state.modelReady = true
        stepState('mediapipe', 'done')
        setProgress(100, '模型与 MediaPipe 已就绪。')
      }

      // ---------- 蓝牙连接 ----------

      async function connect() {
        if (!('bluetooth' in navigator)) return
        const name = document.getElementById('deviceName').value.trim()
        state.connecting = true
        updateGates()
        updateConnectState()
        try {
          const device = await navigator.bluetooth.requestDevice({
            filters: [{ name }],
            optionalServices: [HAND_SERVICE_UUID]
          })
          state.device = device
          device.addEventListener('gattserverdisconnected', () => {
            state.server = null
            state.char = null
            state.lastGestureKey = ''
            clearPresetActive()
            logCommand('机械手连接已断开')
            updateConnectState()
            updateGates()
          })
          const server = await device.gatt.connect()
          const service = await server.getPrimaryService(HAND_SERVICE_UUID)
          state.char = await service.getCharacteristic(HAND_WRITE_CHAR_UUID)
          state.server = server
          state.queue = Promise.resolve()
          logCommand(`已连接 ${device.name || device.id}`)
          setStatus('已就绪', `已连接 ${device.name || device.id}，可以开始控制。`, 'ready')
        } catch (err) {
          state.server = null
          state.char = null
          logCommand(`连接失败: ${err.message || err}`)
          setStatus('连接失败', `${err.name || 'Error'}: ${err.message || err}`, 'warn')
        } finally {
          state.connecting = false
          updateConnectState()
          updateGates()
        }
      }

      function disconnect() {
        if (state.server && state.server.connected) {
          try {
            state.server.disconnect()
          } catch (err) {
            logCommand(`断开异常: ${err.message || err}`)
          }
        }
        state.server = null
        state.char = null
        state.lastGestureKey = ''
        clearPresetActive()
        updateConnectState()
        updateGates()
      }

      // ---------- 摄像头与手势 ----------

      async function openCamera() {
        let stream
        try {
          stream = await navigator.mediaDevices.getUserMedia({
            video: {
              width: { ideal: 640 },
              height: { ideal: 480 },
              facingMode: state.facingMode
            },
            audio: false
          })
        } catch (err) {
          stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false })
        }
        state.cameraStream = stream
        state.cameraOpen = true
        const video = document.getElementById('camera-video')
        video.srcObject = stream
        await video.play()
        showCameraPanel()
        applyPreviewRatio()
        applyPreviewSize()
        applyMirror()
        document.getElementById('gestureStatus').textContent = `摄像头已打开 ${video.videoWidth || 0}x${video.videoHeight || 0}`
        updateGates()
      }

      // 按真实视频流比例设置容器，避免竖向流被裁掉。
      function applyPreviewRatio() {
        const video = document.getElementById('camera-video')
        const panel = document.getElementById('camera-preview')
        if (!video || !panel) return
        const w = video.videoWidth
        const h = video.videoHeight
        if (w && h) panel.style.setProperty('--preview-ratio', `${w} / ${h}`)
      }

      function applyPreviewSize() {
        const panel = document.getElementById('camera-preview')
        if (!panel) return
        const widths = { small: '200px', medium: '280px', large: '380px' }
        panel.style.setProperty('--preview-w', widths[state.previewSize] || widths.medium)
        for (const [key, id] of [
          ['small', 'sizeSmall'],
          ['medium', 'sizeMedium'],
          ['large', 'sizeLarge']
        ]) {
          const btn = document.getElementById(id)
          if (btn) btn.setAttribute('aria-pressed', String(state.previewSize === key))
        }
      }

      function applyMirror() {
        const panel = document.getElementById('camera-preview')
        const btn = document.getElementById('mirrorToggle')
        if (panel) panel.dataset.mirror = state.mirrored ? 'on' : 'off'
        if (btn) btn.setAttribute('aria-pressed', String(state.mirrored))
      }

      async function switchFacing() {
        state.facingMode = state.facingMode === 'user' ? 'environment' : 'user'
        const btn = document.getElementById('facingToggle')
        if (btn) btn.textContent = state.facingMode === 'user' ? '前置' : '后置'
        if (!state.cameraOpen) return
        const wasRunning = state.gestureRunning
        stopGesture()
        if (state.cameraStream) {
          for (const track of state.cameraStream.getTracks()) track.stop()
          state.cameraStream = null
        }
        await openCamera()
        if (wasRunning) startGesture()
      }

      function closeCamera() {
        stopGesture()
        if (state.cameraStream) {
          for (const track of state.cameraStream.getTracks()) track.stop()
          state.cameraStream = null
        }
        state.cameraOpen = false
        const video = document.getElementById('camera-video')
        video.srcObject = null
        const panel = document.getElementById('camera-preview')
        if (panel) panel.hidden = true
        document.getElementById('gestureStatus').textContent = '摄像头未打开'
        updateGates()
      }

      function showCameraPanel() {
        const panel = document.getElementById('camera-preview')
        const body = document.getElementById('camera-body')
        const button = document.getElementById('minimizeCamera')
        if (!panel || !body || !button) return
        panel.hidden = false
        state.cameraMinimized = false
        panel.classList.remove('rh-preview--minimized')
        body.hidden = false
        button.textContent = '收起'
      }

      function toggleCameraMinimized() {
        const panel = document.getElementById('camera-preview')
        const body = document.getElementById('camera-body')
        const button = document.getElementById('minimizeCamera')
        if (!panel || !body || !button) return
        state.cameraMinimized = !state.cameraMinimized
        panel.classList.toggle('rh-preview--minimized', state.cameraMinimized)
        body.hidden = state.cameraMinimized
        button.textContent = state.cameraMinimized ? '展开' : '收起'
      }

      function closeCameraPanel() {
        stopGesture()
        closeCamera()
      }

      function setupCameraDrag() {
        const panel = document.getElementById('camera-preview')
        const handle = document.getElementById('cameraDragHandle')
        if (!panel || !handle) return
        let drag = null

        handle.addEventListener('pointerdown', (event) => {
          if (event.target.closest('button')) return
          const rect = panel.getBoundingClientRect()
          drag = {
            pointerId: event.pointerId,
            startX: event.clientX,
            startY: event.clientY,
            left: rect.left,
            top: rect.top
          }
          handle.setPointerCapture(event.pointerId)
        })

        handle.addEventListener('pointermove', (event) => {
          if (!drag || drag.pointerId !== event.pointerId) return
          const nextLeft = drag.left + event.clientX - drag.startX
          const nextTop = drag.top + event.clientY - drag.startY
          const maxLeft = window.innerWidth - panel.offsetWidth - 6
          const maxTop = window.innerHeight - 48
          panel.style.left = `${Math.max(6, Math.min(maxLeft, nextLeft))}px`
          panel.style.top = `${Math.max(6, Math.min(maxTop, nextTop))}px`
          panel.style.right = 'auto'
          panel.style.bottom = 'auto'
        })

        const endDrag = (event) => {
          if (!drag || drag.pointerId !== event.pointerId) return
          drag = null
          if (handle.hasPointerCapture && handle.hasPointerCapture(event.pointerId)) {
            handle.releasePointerCapture(event.pointerId)
          }
        }
        handle.addEventListener('pointerup', endDrag)
        handle.addEventListener('pointercancel', endDrag)
      }

      function stopGesture() {
        if (!state.gestureRunning) return
        state.gestureRunning = false
        releaseWakeLock()
        cancelAnimationFrame(state.gestureRaf)
        document.getElementById('stopGestureBtn').hidden = true
        document.getElementById('gestureBtn').textContent = '开始手势识别'
        document.getElementById('gestureStatus').textContent =
          state.gestureHandFrames > 0
            ? `已停止；检测到手 ${state.gestureHandFrames} 帧`
            : '已停止；未检测到手部'
        const canvas = document.getElementById('gesture-canvas')
        const ctx = canvas && canvas.getContext('2d')
        if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height)
        updateGates()
      }

      // 手势识别期间保持亮屏：优先标准 Wake Lock，Bluefy 用其扩展接口。
      async function requestWakeLock() {
        try {
          if (navigator.bluetooth && typeof navigator.bluetooth.setScreenDimEnabled === 'function') {
            navigator.bluetooth.setScreenDimEnabled(true)
          }
        } catch (err) {
          // Bluefy 扩展接口不可用时忽略。
        }
        try {
          if (navigator.wakeLock && typeof navigator.wakeLock.request === 'function') {
            state.wakeLock = await navigator.wakeLock.request('screen')
          }
        } catch (err) {
          // 部分平台不支持 Wake Lock，忽略即可。
        }
      }

      function releaseWakeLock() {
        try {
          if (navigator.bluetooth && typeof navigator.bluetooth.setScreenDimEnabled === 'function') {
            navigator.bluetooth.setScreenDimEnabled(false)
          }
        } catch (err) {
          // 忽略。
        }
        if (state.wakeLock && typeof state.wakeLock.release === 'function') {
          state.wakeLock.release().catch(() => {})
        }
        state.wakeLock = null
      }

      function startGesture() {
        if (!state.cameraOpen || !state.modelReady || state.gestureRunning) return
        state.gestureRunning = true
        requestWakeLock()
        state.gestureFrames = 0
        state.gestureHandFrames = 0
        state.gestureLastDetect = 0
        state.gestureTimestamp = 0
        document.getElementById('stopGestureBtn').hidden = false
        document.getElementById('gestureBtn').textContent = '手势识别中'
        document.getElementById('gestureStatus').textContent = '正在识别，请把手放到画面中央'

        const video = document.getElementById('camera-video')
        const canvas = document.getElementById('gesture-canvas')
        const ctx = canvas.getContext('2d')

        const tick = () => {
          if (!state.gestureRunning) return
          if (document.hidden) {
            state.gestureRaf = requestAnimationFrame(tick)
            return
          }
          if (video.readyState < 2) {
            state.gestureRaf = requestAnimationFrame(tick)
            return
          }
          const now = performance.now()
          if (now - state.gestureLastDetect < DETECT_INTERVAL_MS) {
            state.gestureRaf = requestAnimationFrame(tick)
            return
          }
          state.gestureLastDetect = now
          const w = video.videoWidth
          const h = video.videoHeight
          if (!w || !h) {
            state.gestureRaf = requestAnimationFrame(tick)
            return
          }
          if (canvas.width !== w || canvas.height !== h) {
            canvas.width = w
            canvas.height = h
          }
          ctx.clearRect(0, 0, w, h)
          state.gestureFrames++
          state.gestureTimestamp = Math.max(state.gestureTimestamp + 1, Math.round(now))
          try {
            const result = state.landmarker.detectForVideo(video, state.gestureTimestamp)
            const hands = result.landmarks || result.handLandmarks
            if (hands && hands.length) {
              state.gestureHandFrames++
              drawHand(ctx, hands[0], w, h)
              const gesture = recognize(hands[0])
              document.getElementById('gestureStatus').textContent = `识别到: ${gesture.name}`
              driveHand(gesture)
            } else {
              document.getElementById('gestureStatus').textContent = '等待手进入画面'
            }
          } catch (err) {
            document.getElementById('gestureStatus').textContent = `识别异常: ${err.message}`
            stopGesture()
            return
          }
          state.gestureRaf = requestAnimationFrame(tick)
        }
        state.gestureRaf = requestAnimationFrame(tick)
        updateGates()
      }

      function drawHand(ctx, landmarks, w, h) {
        ctx.strokeStyle = '#22c55e'
        ctx.lineWidth = 3
        ctx.beginPath()
        for (const [a, b] of HAND_CONNECTIONS) {
          const p1 = landmarks[a]
          const p2 = landmarks[b]
          if (!p1 || !p2) continue
          ctx.moveTo(p1.x * w, p1.y * h)
          ctx.lineTo(p2.x * w, p2.y * h)
        }
        ctx.stroke()
        ctx.fillStyle = '#ef4444'
        for (const p of landmarks) {
          ctx.beginPath()
          ctx.arc(p.x * w, p.y * h, 4, 0, Math.PI * 2)
          ctx.fill()
        }
      }

      function dist(a, b) {
        return Math.hypot(a.x - b.x, a.y - b.y)
      }

      function angle3(a, b, c) {
        const v1 = [a.x - b.x, a.y - b.y, a.z - b.z]
        const v2 = [c.x - b.x, c.y - b.y, c.z - b.z]
        const dot = v1[0] * v2[0] + v1[1] * v2[1] + v1[2] * v2[2]
        const len = Math.hypot(...v1) * Math.hypot(...v2)
        if (!len) return 0
        return (Math.acos(Math.max(-1, Math.min(1, dot / len))) * 180) / Math.PI
      }

      function recognize(landmarks) {
        const tips = [4, 8, 12, 16, 20]
        const pips = [2, 6, 10, 14, 18]
        const wrist = landmarks[0]
        const fingers = [0, 0, 0, 0, 0]
        for (let i = 0; i < tips.length; i++) {
          if (dist(landmarks[tips[i]], wrist) > dist(landmarks[pips[i]], wrist) * 0.8) {
            fingers[i] = 1
          }
        }
        fingers[0] = angle3(landmarks[2], landmarks[3], landmarks[4]) > 160 ? 1 : 0
        const count = fingers.reduce((sum, v) => sum + v, 0)
        let name = `手势 ${count}`
        if (count === 0) name = '握拳 (Fist)'
        else if (count === 5) name = '张开 (Open Palm)'
        else {
          name = FINGER_LABELS.filter((_, i) => fingers[i]).join(' + ') || '握拳'
        }
        return { fingers, name }
      }

      function driveHand(gesture) {
        if (!connected() || !document.getElementById('gestureDrive').checked) return
        const key = gesture.fingers.join(',')
        if (key === state.lastGestureKey) return
        const now = performance.now()
        if (now - (state.lastGestureSentAt || 0) < GESTURE_MIN_INTERVAL_MS) return
        state.lastGestureKey = key
        state.lastGestureSentAt = now
        clearPresetActive()
        gesture.fingers.forEach((up, index) => {
          enqueueCommand(`servo_${index}=${up === 1 ? 0 : 180}`)
        })
        logCommand(`手势驱动: ${gesture.name}`)
      }

      // ---------- 启动 ----------

      async function boot() {
        buildPanels()
        updateGates()

        for (const step of steps) {
          const li = document.createElement('li')
          li.dataset.step = step.id
          li.textContent = step.label
          progressList.appendChild(li)
        }

        const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)
        state.secure = Boolean(window.isSecureContext && (location.protocol === 'https:' || local))
        stepState('secure', state.secure ? 'done' : 'error')

        state.bluetoothOk = 'bluetooth' in navigator
        state.cameraApiOk =
          Boolean(navigator.mediaDevices) &&
          typeof navigator.mediaDevices.getUserMedia === 'function'
        stepState('bluetooth', state.bluetoothOk ? 'done' : 'error')
        stepState('camera', state.cameraApiOk ? 'done' : 'error')
        const platform = detectPlatform()
        setProgress(15, `环境检查完成：${platform.browser} / ${platform.os}`)

        if (!state.secure) {
          setStatus(
            '无法使用完整控制',
            '当前不是 HTTPS 安全上下文，蓝牙和摄像头会被浏览器禁用。请通过 https://zh.maxtonniu.com/robothand 访问。',
            'error'
          )
          const unsupported = document.getElementById('unsupportedPanel')
          unsupported.hidden = false
          document.getElementById('unsupportedText').textContent =
            '当前页面不是 HTTPS，或不是 localhost。蓝牙和摄像头 API 都无法使用。'
          updateGates()
          return
        }

        // iOS Safari 没有 Web Bluetooth，需要引导到 Bluefy。
        if (!state.bluetoothOk && platform.ios) {
          const unsupported = document.getElementById('unsupportedPanel')
          unsupported.hidden = false
          document.getElementById('unsupportedText').innerHTML =
            'iOS 的 Safari、Chrome、Edge 都不支持 Web Bluetooth，无法直接连接机械手。' +
            '<br />请在 App Store 安装免费的 <strong>Bluefy – Web BLE Browser</strong>，' +
            '然后在 Bluefy 中打开本页面。' +
            '<br /><button class="rh-action-btn" id="copyPageLink" type="button" style="margin-top:10px">复制本页链接</button>'
          const copyBtn = document.getElementById('copyPageLink')
          if (copyBtn) {
            copyBtn.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(location.href)
                copyBtn.textContent = '已复制，去 Bluefy 粘贴'
              } catch (err) {
                copyBtn.textContent = location.href
              }
            })
          }
        }

        try {
          await initMediapipe()
          state.initDone = true
          setStatus(
            '已就绪',
            state.bluetoothOk
              ? '环境已就绪，请连接机械手。'
              : '手势识别已就绪，但当前浏览器不支持蓝牙控制。',
            state.bluetoothOk ? 'ready' : 'warn'
          )
        } catch (err) {
          stepState('model', 'error')
          stepState('mediapipe', 'error')
          state.initDone = true
          setStatus('模型加载失败', `${err.name || 'Error'}: ${err.message || err}`, 'warn')
          setReason('cameraReason', '手部模型或 MediaPipe 初始化失败，请打开详细诊断页查看原因。')
        } finally {
          updateGates()
        }
      }

      document.getElementById('connectBtn').addEventListener('click', connect)
      document.getElementById('disconnectBtn').addEventListener('click', disconnect)
      document.getElementById('cameraBtn').addEventListener('click', () => {
        if (state.cameraOpen) closeCamera()
        else openCamera()
      })
      document.getElementById('gestureBtn').addEventListener('click', startGesture)
      document.getElementById('stopGestureBtn').addEventListener('click', stopGesture)
      document.getElementById('minimizeCamera').addEventListener('click', toggleCameraMinimized)
      document.getElementById('sizeSmall').addEventListener('click', () => {
        state.previewSize = 'small'
        applyPreviewSize()
      })
      document.getElementById('sizeMedium').addEventListener('click', () => {
        state.previewSize = 'medium'
        applyPreviewSize()
      })
      document.getElementById('sizeLarge').addEventListener('click', () => {
        state.previewSize = 'large'
        applyPreviewSize()
      })
      document.getElementById('mirrorToggle').addEventListener('click', () => {
        state.mirrored = !state.mirrored
        applyMirror()
      })
      document.getElementById('facingToggle').addEventListener('click', switchFacing)
      document.getElementById('closeCamera').addEventListener('click', closeCameraPanel)
      setupCameraDrag()
      document.getElementById('sendBtn').addEventListener('click', () => {
        const input = document.getElementById('customCommand')
        const text = input.value.trim()
        if (text) enqueueCommand(text)
      })
      document.getElementById('customCommand').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('sendBtn').click()
      })
      document.getElementById('clearLogBtn').addEventListener('click', () => {
        document.getElementById('commandLog').textContent = '暂无指令'
      })

      window.addEventListener('resize', () => {
        const panel = document.getElementById('camera-preview')
        if (!panel || panel.hidden || !panel.style.left) return
        const maxLeft = Math.max(6, window.innerWidth - panel.offsetWidth - 6)
        const maxTop = Math.max(6, window.innerHeight - 48)
        const left = parseFloat(panel.style.left) || 0
        const top = parseFloat(panel.style.top) || 0
        panel.style.left = `${Math.min(maxLeft, Math.max(6, left))}px`
        panel.style.top = `${Math.min(maxTop, Math.max(6, top))}px`
      })

      window.addEventListener('beforeunload', () => {
        closeCamera()
        if (state.server && state.server.connected) {
          try {
            state.server.disconnect()
          } catch (err) {
            // 页面卸载，忽略断开异常。
          }
        }
      })

      boot()
    </script>
  </body>
</html>
