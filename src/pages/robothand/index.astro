---
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  title: '机械手环境测试',
  description: '逐步检测摄像头、MediaPipe 手势识别、Web Bluetooth 和 BLE 设备连接能力'
}
---

<PageLayout {meta}>
  <main class="rh-test">
    <section class="rh-hero">
      <h1>机械手环境测试</h1>
      <p>这个页面按步骤检查当前浏览器能否完成摄像头、手势识别、蓝牙发现与 BLE 连接。每步都会记录通过、警告、失败和错误详情。</p>
      <div class="rh-actions">
        <button id="runAuto" type="button">自动环境检测</button>
        <button id="copyReport" type="button">复制测试报告</button>
        <button id="downloadReport" type="button">下载 JSON 报告</button>
      </div>
      <div id="summary" class="rh-summary">等待检测</div>
    </section>

    <section class="rh-preview" id="camera-preview" hidden>
      <h2>摄像头预览</h2>
      <div class="rh-preview-box">
        <video id="camera-video" autoplay muted playsinline></video>
        <canvas id="gesture-canvas"></canvas>
      </div>
      <p id="gesture-status">未开始识别</p>
      <p id="gesture-debug" class="rh-debug">调试: 未启动</p>
      <div class="rh-actions">
        <button id="stopGesture" type="button" hidden>停止手势识别</button>
        <button id="closeCamera" type="button">关闭摄像头</button>
      </div>
    </section>

    <section id="tests" class="rh-tests" aria-live="polite"></section>
  </main>
</PageLayout>

<style is:global>
  .rh-test {
    margin: 0 auto;
    max-width: 860px;
    padding: 24px 0 40px;
  }

  .rh-hero {
    margin-bottom: 22px;
  }

  .rh-hero h1 {
    margin: 0 0 8px;
    font-size: 26px;
    line-height: 1.3;
  }

  .rh-hero p {
    margin: 0 0 14px;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
  }

  .rh-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rh-actions button,
  .rh-action-btn {
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    padding: 9px 14px;
    font-size: 14px;
    cursor: pointer;
    line-height: 1.2;
  }

  .rh-actions button:hover,
  .rh-action-btn:hover {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
  }

  .rh-actions button:disabled,
  .rh-action-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .rh-summary {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    font-size: 14px;
  }

  .rh-preview {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    width: min(320px, calc(100vw - 32px));
    padding: 10px 12px;
    border: 1px solid hsl(var(--border));
    border-radius: 10px;
    background: hsl(var(--card));
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
  }

  .rh-preview h2 {
    margin: 0 0 8px;
    font-size: 14px;
  }

  .rh-preview-box {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: #111;
  }

  #camera-video,
  #gesture-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
  }

  #camera-video {
    z-index: 1;
    pointer-events: none;
  }

  #gesture-canvas {
    z-index: 2;
    pointer-events: none;
    background: transparent;
  }

  #gesture-status {
    margin: 10px 0 0;
    font-size: 14px;
  }

  .rh-debug {
    margin: 4px 0 0;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .rh-tests {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rh-test-row {
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--card));
    padding: 12px 14px;
  }

  .rh-test-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .rh-test-title {
    margin: 0;
    font-size: 15px;
    line-height: 1.4;
  }

  .rh-test-meta {
    margin: 3px 0 0;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }

  .rh-status {
    flex: 0 0 auto;
    min-width: 64px;
    text-align: center;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }

  .rh-status.pending { background: hsl(var(--muted)); color: hsl(var(--muted-foreground)); }
  .rh-status.running { background: hsl(var(--primary) / 0.16); color: hsl(var(--primary)); }
  .rh-status.pass { background: hsl(142 70% 45% / 0.16); color: hsl(142 70% 35%); }
  .rh-status.warn { background: hsl(38 92% 50% / 0.16); color: hsl(38 92% 35%); }
  .rh-status.fail { background: hsl(0 84% 60% / 0.14); color: hsl(0 84% 48%); }
  .rh-status.skip { background: hsl(var(--muted)); color: hsl(var(--muted-foreground)); }

  .rh-test-detail {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
    word-break: break-word;
  }

  .rh-error {
    margin: 10px 0 0;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid hsl(0 84% 60% / 0.35);
    background: hsl(0 84% 60% / 0.06);
    font-size: 12px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .rh-error strong {
    display: block;
    margin-bottom: 4px;
  }

  .rh-action-row {
    margin-top: 10px;
  }

  @media (max-width: 640px) {
    .rh-hero h1 {
      font-size: 22px;
    }

    .rh-actions {
      flex-direction: column;
    }

    .rh-actions button {
      width: 100%;
    }

    .rh-test-head {
      flex-direction: column;
    }
  }
</style>

<script is:inline type="module">
  const MODEL_PATH = '/robothand/hand_landmarker.task'
  const CDN_BASE = 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1'
  const HAND_CONNECTIONS = [
    [0, 1], [1, 2], [2, 3], [3, 4],
    [0, 5], [5, 6], [6, 7], [7, 8],
    [0, 9], [9, 10], [10, 11], [11, 12],
    [0, 13], [13, 14], [14, 15], [15, 16],
    [0, 17], [17, 18], [18, 19], [19, 20]
  ]
  const COMMON_SERVICES = [
    '00001800-0000-1000-8000-00805f9b34fb',
    '00001801-0000-1000-8000-00805f9b34fb',
    '0000180a-0000-1000-8000-00805f9b34fb',
    '0000180d-0000-1000-8000-00805f9b34fb',
    '0000180f-0000-1000-8000-00805f9b34fb'
  ]

  const state = {
    cameraStream: null,
    modelBuffer: null,
    landmarker: null,
    bleDevice: null,
    bleServer: null,
    bleServices: [],
    gestureRaf: 0,
    gestureRunning: false,
    gestureSeen: false,
    gestureFrames: 0,
    gestureHandFrames: 0,
    gestureLastDebug: 0,
    busy: false
  }

  const TESTS = [
    {
      id: 'secure-context',
      name: '安全上下文',
      group: '环境',
      auto: true,
      expected: '页面运行在 HTTPS 或 localhost',
      run: async () => {
        const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)
        const ok = window.isSecureContext && (location.protocol === 'https:' || local)
        const lanIp = /^(\d{1,3}\.){3}\d{1,3}$/.test(location.hostname)
        return {
          status: ok ? 'pass' : 'fail',
          actual: ok ? `${location.origin} 安全上下文正常` : `${location.href} 不是安全上下文`,
          suggestion: ok
            ? ''
            : lanIp
              ? '安卓手机通过局域网 IP 访问时必须使用 HTTPS；请部署到 Cloudflare Pages，或使用 HTTPS 隧道访问。'
              : '请通过 HTTPS 部署到 Cloudflare Pages，或使用 localhost 调试。'
        }
      }
    },
    {
      id: 'platform',
      name: '浏览器与平台识别',
      group: '环境',
      auto: true,
      expected: '能识别当前浏览器和操作系统',
      run: async () => {
        const info = detectPlatform()
        return { status: 'pass', actual: `${info.browser} / ${info.os}` }
      }
    },
    {
      id: 'bluetooth-api',
      name: 'Web Bluetooth API',
      group: '蓝牙',
      auto: true,
      expected: 'navigator.bluetooth 存在',
      run: async () => {
        if (!('bluetooth' in navigator)) {
          if (!window.isSecureContext) {
            return {
              status: 'fail',
              actual: '非安全上下文，Web Bluetooth 被浏览器禁用',
              suggestion: '请使用 HTTPS 或 localhost 访问，例如先部署到 Cloudflare Pages。'
            }
          }
          const info = detectPlatform()
          if (info.ios) {
            return {
              status: 'warn',
              actual: '当前为 iOS Safari，没有 Web Bluetooth',
              suggestion: '请复制本页链接，在 Bluefy 中打开后重新测试。'
            }
          }
          throw new Error('当前浏览器不支持 Web Bluetooth API')
        }
        return { status: 'pass', actual: 'navigator.bluetooth 可用' }
      }
    },
    {
      id: 'media-devices',
      name: '摄像头 API',
      group: '摄像头',
      auto: true,
      expected: 'navigator.mediaDevices.getUserMedia 存在',
      run: async () => {
        if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== 'function') {
          if (!window.isSecureContext) {
            return {
              status: 'fail',
              actual: '非安全上下文，getUserMedia 被浏览器禁用',
              suggestion: '请使用 HTTPS 或 localhost 访问，例如先部署到 Cloudflare Pages。'
            }
          }
          throw new Error('getUserMedia 不存在')
        }
        return { status: 'pass', actual: 'navigator.mediaDevices.getUserMedia 可用' }
      }
    },
    {
      id: 'wasm',
      name: 'WebAssembly',
      group: '运行环境',
      auto: true,
      expected: 'WebAssembly 可以实例化',
      run: async () => {
        if (typeof WebAssembly === 'undefined') {
          throw new Error('当前浏览器没有 WebAssembly')
        }
        await WebAssembly.instantiate(new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0]))
        return { status: 'pass', actual: 'WebAssembly 可用' }
      }
    },
    {
      id: 'webgl',
      name: 'WebGL',
      group: '运行环境',
      auto: true,
      expected: 'WebGL2 或 WebGL1 可用',
      run: async () => {
        const canvas = document.createElement('canvas')
        const gl2 = canvas.getContext('webgl2')
        const gl1 = canvas.getContext('webgl') || canvas.getContext('experimental-webgl')
        if (gl2) return { status: 'pass', actual: 'WebGL2 可用' }
        if (gl1) return { status: 'warn', actual: '仅 WebGL1 可用，MediaPipe 可能降低画质', suggestion: '建议使用较新的 Chrome/Edge 或 iOS 系统版本。' }
        throw new Error('WebGL 不可用')
      }
    },
    {
      id: 'bluefy-extras',
      name: 'Bluefy / 浏览器扩展能力',
      group: '环境',
      auto: true,
      expected: '检测 Bluefy 提供的扩展接口',
      run: async () => {
        const found = []
        const bt = navigator.bluetooth
        if (bt && typeof bt.getDevices === 'function') found.push('getDevices')
        if (bt && typeof bt.setScreenDimEnabled === 'function') found.push('setScreenDimEnabled')
        if (window.BLENative && typeof window.BLENative.notifyAppState === 'function') found.push('BLENative.notifyAppState')
        if (!found.length) {
          const info = detectPlatform()
          if (info.ios && !('bluetooth' in navigator)) {
            return { status: 'warn', actual: '未发现 Bluefy 扩展', suggestion: 'iPhone 请在 Bluefy 中打开以启用 Web Bluetooth。' }
          }
          return { status: 'pass', actual: '无 Bluefy 扩展，符合普通 Chrome/Edge 行为' }
        }
        return { status: 'pass', actual: found.join(', ') }
      }
    },
    {
      id: 'camera-open',
      name: '打开摄像头',
      group: '摄像头',
      auto: false,
      interactive: true,
      actionLabel: '打开摄像头',
      expected: '能打开前置摄像头并显示视频流',
      run: async () => {
        await stopCamera()
        let stream
        try {
          stream = await navigator.mediaDevices.getUserMedia({
            video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' },
            audio: false
          })
        } catch (err) {
          stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false })
        }
        state.cameraStream = stream
        const video = document.getElementById('camera-video')
        video.srcObject = stream
        await video.play()
        document.getElementById('camera-preview').hidden = false
        const size = `${video.videoWidth || 0}x${video.videoHeight || 0}`
        if (!video.videoWidth || !video.videoHeight) {
          throw new Error('摄像头已打开但没有视频尺寸')
        }
        return { status: 'pass', actual: `视频流正常 ${size}` }
      }
    },
    {
      id: 'model-asset',
      name: '手部模型加载',
      group: '手势识别',
      auto: true,
      interactive: true,
      actionLabel: '加载手部模型',
      expected: 'hand_landmarker.task 能下载且大小正常',
      run: async () => {
        const res = await fetch(MODEL_PATH, { cache: 'force-cache' })
        if (!res.ok) throw new Error(`模型下载失败 HTTP ${res.status}`)
        const buffer = await res.arrayBuffer()
        if (buffer.byteLength < 1000000) {
          throw new Error(`模型文件过小: ${buffer.byteLength} bytes`)
        }
        state.modelBuffer = buffer
        return { status: 'pass', actual: `${(buffer.byteLength / 1048576).toFixed(1)} MB` }
      }
    },
    {
      id: 'mediapipe-init',
      name: 'MediaPipe 初始化',
      group: '手势识别',
      auto: true,
      interactive: true,
      requires: ['model-asset'],
      actionLabel: '初始化 MediaPipe',
      expected: '能加载 MediaPipe WASM 并创建 HandLandmarker',
      run: async () => {
        if (!state.modelBuffer) throw new Error('请先执行“手部模型加载”')
        const { FilesetResolver, HandLandmarker } = await import(`${CDN_BASE}/vision_bundle.mjs`)
        const vision = await FilesetResolver.forVisionTasks(`${CDN_BASE}/wasm`)
        const landmarker = await HandLandmarker.createFromOptions(vision, {
          baseOptions: { modelAssetBuffer: new Uint8Array(state.modelBuffer) },
          runningMode: 'VIDEO',
          numHands: 1,
          minHandDetectionConfidence: 0.7,
          minTrackingConfidence: 0.5
        })
        state.landmarker = landmarker
        return { status: 'pass', actual: 'HandLandmarker 创建成功' }
      }
    },
    {
      id: 'gesture-detect',
      name: '手势识别',
      group: '手势识别',
      auto: false,
      interactive: true,
      requires: ['camera-open', 'mediapipe-init'],
      actionLabel: '开始手势识别',
      expected: '能从摄像头画面识别出手部关键点和手势',
      run: async () => {
        if (!state.cameraStream) throw new Error('请先完成“打开摄像头”')
        if (!state.landmarker) throw new Error('请先完成“MediaPipe 初始化”')
        return runGestureDetection()
      }
    },
    {
      id: 'ble-discover',
      name: '蓝牙设备发现',
      group: '蓝牙',
      auto: false,
      interactive: true,
      actionLabel: '扫描附近 BLE 设备',
      expected: '能弹出系统蓝牙选择框并选择一个设备',
      run: async () => {
        if (!('bluetooth' in navigator)) throw new Error('当前浏览器没有 Web Bluetooth')
        const device = await navigator.bluetooth.requestDevice({
          acceptAllDevices: true,
          optionalServices: COMMON_SERVICES
        })
        state.bleDevice = device
        device.addEventListener('gattserverdisconnected', () => {
          state.bleServer = null
          patch('ble-connect', {
            status: 'warn',
            actual: 'BLE 设备已断开',
            suggestion: '重新执行 BLE 连接测试。'
          })
        })
        return { status: 'pass', actual: `${device.name || '未命名设备'} / ${device.id}` }
      }
    },
    {
      id: 'ble-connect',
      name: 'BLE 连接',
      group: '蓝牙',
      auto: false,
      interactive: true,
      requires: ['ble-discover'],
      actionLabel: '连接该 BLE 设备',
      expected: '能连接用户选择的 BLE 设备',
      run: async () => {
        if (!state.bleDevice) throw new Error('请先完成“蓝牙设备发现”')
        state.bleServer = await state.bleDevice.gatt.connect()
        return { status: 'pass', actual: `已连接 ${state.bleDevice.name || state.bleDevice.id}` }
      }
    },
    {
      id: 'ble-services',
      name: 'BLE 服务与特征读取',
      group: '蓝牙',
      auto: false,
      interactive: true,
      requires: ['ble-connect'],
      actionLabel: '读取服务与特征',
      expected: '能列出服务和特征，并尝试读取标准设备名',
      run: async () => {
        if (!state.bleServer) throw new Error('请先完成“BLE 连接”')
        const services = await state.bleServer.getPrimaryServices()
        state.bleServices = services
        if (!services.length) {
          return {
            status: 'warn',
            actual: '已连接但没有可访问服务',
            suggestion: '部分浏览器只允许访问 optionalServices 中声明的服务，请更换测试设备或重新扫描。'
          }
        }
        let charCount = 0
        for (const service of services) {
          try {
            const chars = await service.getCharacteristics()
            charCount += chars.length
          } catch (err) {
            charCount += 0
          }
        }
        let deviceName = '未读取'
        try {
          const ga = await state.bleServer.getPrimaryService('00001800-0000-1000-8000-00805f9b34fb')
          const nameChar = await ga.getCharacteristic('00002a00-0000-1000-8000-00805f9b34fb')
          const value = await nameChar.readValue()
          deviceName = new TextDecoder().decode(value) || '空值'
        } catch (err) {
          deviceName = `读取失败: ${err.message}`
        }
        return {
          status: 'pass',
          actual: `${services.length} 个服务 / ${charCount} 个特征 / 设备名: ${deviceName}`
        }
      }
    },
    {
      id: 'combined',
      name: '摄像头 + BLE 同时使用',
      group: '组合',
      auto: false,
      interactive: true,
      actionLabel: '检查组合状态',
      expected: '摄像头和 BLE 能同时保持可用',
      run: async () => {
        if (!state.cameraStream) {
          return { status: 'warn', actual: '摄像头未打开', suggestion: '先完成摄像头测试。' }
        }
        if (!state.bleServer || !state.bleServer.connected) {
          return { status: 'warn', actual: 'BLE 未连接', suggestion: '先完成 BLE 连接测试。' }
        }
        return { status: 'pass', actual: '摄像头与 BLE 同时可用' }
      }
    },
    {
      id: 'report',
      name: '生成测试报告',
      group: '报告',
      auto: false,
      interactive: true,
      actionLabel: '生成 JSON 报告',
      expected: '汇总当前所有测试结果',
      run: async () => {
        return { status: 'pass', actual: `报告共 ${TESTS.length} 项，可点击“复制测试报告”导出` }
      }
    }
  ]

  const byId = new Map(TESTS.map((t) => [t.id, t]))

  function detectPlatform() {
    const ua = navigator.userAgent || ''
    const ios = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
    const android = /Android/i.test(ua)
    let os = 'Windows'
    if (ios) os = 'iOS'
    else if (android) os = 'Android'
    else if (/Mac OS X/i.test(ua)) os = 'macOS'
    else if (/Linux/i.test(ua)) os = 'Linux'

    let browser = '未知浏览器'
    if (/Edg\//i.test(ua)) browser = 'Microsoft Edge'
    else if (/Chrome\//i.test(ua) && !/Edg\//i.test(ua)) browser = 'Chrome / Chromium'
    else if (/Firefox\//i.test(ua)) browser = 'Firefox'
    else if (/Safari\//i.test(ua) && !/Chrome\//i.test(ua)) {
      browser = ios && 'bluetooth' in navigator ? 'Bluefy / Web BLE 浏览器' : 'Safari'
    }
    return { os, browser, ios, android, ua }
  }

  function patch(id, data) {
    const test = byId.get(id)
    if (!test) return
    Object.assign(test, data)
    renderTest(id)
    updateSummary()
  }

  function renderTest(id) {
    const test = byId.get(id)
    const row = document.querySelector(`[data-test-id="${id}"]`)
    if (!row) return
    const statusEl = row.querySelector('.rh-status')
    statusEl.className = `rh-status ${test.status || 'pending'}`
    statusEl.textContent = statusText(test.status)
    const detailEl = row.querySelector('.rh-test-detail')
    detailEl.textContent = test.actual ? `实际: ${test.actual}` : '尚未执行'
    const errBox = row.querySelector('.rh-error')
    if (test.errorMessage || test.errorName) {
      errBox.hidden = false
      errBox.innerHTML = ''
      const strong = document.createElement('strong')
      strong.textContent = `错误位置: ${test.name}`
      errBox.appendChild(strong)
      const line = document.createElement('div')
      line.textContent = `${test.errorName || 'Error'}: ${test.errorMessage || '未知错误'}`
      errBox.appendChild(line)
      if (test.stack) {
        const stack = document.createElement('div')
        stack.textContent = test.stack.split('\n').slice(0, 4).join('\n')
        errBox.appendChild(stack)
      }
    } else {
      errBox.hidden = true
      errBox.innerHTML = ''
    }
    const suggestion = row.querySelector('.rh-suggestion')
    suggestion.textContent = test.suggestion ? `建议: ${test.suggestion}` : ''
    const btn = row.querySelector('.rh-action-btn')
    if (btn) {
      if (test.interactive) {
        btn.textContent = test.actionLabel || '执行'
      } else if (test.status && test.status !== 'pending') {
        btn.textContent = '重测'
      } else {
        btn.textContent = '执行'
      }
      btn.disabled = state.busy || test.status === 'running'
    }
  }

  function updateButtons() {
    for (const test of TESTS) {
      const row = document.querySelector(`[data-test-id="${test.id}"]`)
      const btn = row && row.querySelector('.rh-action-btn')
      if (btn) {
        btn.disabled = state.busy || test.status === 'running'
      }
    }
  }

  function statusText(status) {
    return {
      pending: '待测',
      running: '运行中',
      pass: '通过',
      warn: '警告',
      fail: '失败',
      skip: '跳过'
    }[status] || '待测'
  }

  function renderTests() {
    const container = document.getElementById('tests')
    container.innerHTML = ''
    for (const test of TESTS) {
      const row = document.createElement('article')
      row.className = 'rh-test-row'
      row.dataset.testId = test.id

      const head = document.createElement('div')
      head.className = 'rh-test-head'

      const titleWrap = document.createElement('div')
      const title = document.createElement('h2')
      title.className = 'rh-test-title'
      title.textContent = `${test.group} / ${test.name}`
      const meta = document.createElement('p')
      meta.className = 'rh-test-meta'
      meta.textContent = `期望: ${test.expected}`
      titleWrap.appendChild(title)
      titleWrap.appendChild(meta)
      head.appendChild(titleWrap)

      const status = document.createElement('span')
      status.className = 'rh-status pending'
      status.textContent = '待测'
      head.appendChild(status)
      row.appendChild(head)

      const detail = document.createElement('div')
      detail.className = 'rh-test-detail'
      detail.textContent = '尚未执行'
      row.appendChild(detail)

      const suggestion = document.createElement('div')
      suggestion.className = 'rh-test-detail rh-suggestion'
      row.appendChild(suggestion)

      const error = document.createElement('div')
      error.className = 'rh-error'
      error.hidden = true
      row.appendChild(error)

      if (test.interactive || test.auto) {
        const actionRow = document.createElement('div')
        actionRow.className = 'rh-action-row'
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'rh-action-btn'
        btn.textContent = test.interactive ? (test.actionLabel || '执行') : '执行'
        btn.addEventListener('click', () => runTest(test.id))
        actionRow.appendChild(btn)
        row.appendChild(actionRow)
      }

      container.appendChild(row)
    }
  }

  async function runAutoTests() {
    if (state.busy) return
    state.busy = true
    updateButtons()
    try {
      for (const test of TESTS) {
        if (!test.auto) continue
        try {
          await executeTest(test.id, 0)
        } catch (err) {
          if (test.status === 'pending' || test.status === 'running') {
            patch(test.id, {
              status: 'fail',
              actual: `前置步骤未完成: ${err.message || err}`,
              errorName: err.name || 'Error',
              errorMessage: err.message || String(err),
              errorStack: err.stack || '',
              suggestion: '请先完成前置步骤，或点击对应测试项查看失败原因。'
            })
          }
        }
      }
      updateSummary()
    } finally {
      state.busy = false
      updateButtons()
      updateSummary()
    }
  }

  async function runTest(id) {
    const test = byId.get(id)
    if (!test || state.busy || test.status === 'running') return
    state.busy = true
    try {
      await executeTest(id, 0)
    } catch (err) {
      if (test.status === 'pending' || test.status === 'running') {
        patch(id, {
          status: 'fail',
          actual: `前置步骤未完成: ${err.message || err}`,
          errorName: err.name || 'Error',
          errorMessage: err.message || String(err),
          errorStack: err.stack || '',
          suggestion: '请先完成前置步骤，或点击对应测试项查看失败原因。'
        })
      }
    } finally {
      state.busy = false
      updateButtons()
      updateSummary()
    }
  }

  async function executeTest(id, depth) {
    const test = byId.get(id)
    if (!test) return
    if (depth > 8) throw new Error('前置步骤嵌套过深')
    if (test.requires && test.requires.length) {
      for (const requiredId of test.requires) {
        const required = byId.get(requiredId)
        if (!required) continue
        if (required.status !== 'pass' && required.status !== 'warn') {
          await executeTest(requiredId, depth + 1)
          if (required.status !== 'pass' && required.status !== 'warn') {
            throw new Error(`“${required.name}”未通过: ${required.actual || required.errorMessage || '请先执行该步骤'}`)
          }
        }
      }
    }
    if (test.status === 'running') return
    patch(id, {
      status: 'running',
      actual: '',
      errorName: '',
      errorMessage: '',
      errorStack: '',
      suggestion: ''
    })
    try {
      const result = await test.run()
      patch(id, {
        status: result.status || 'pass',
        actual: result.actual || '',
        suggestion: result.suggestion || ''
      })
    } catch (err) {
      patch(id, {
        status: 'fail',
        actual: `抛出异常: ${err.message || err}`,
        errorName: err.name || 'Error',
        errorMessage: err.message || String(err),
        errorStack: err.stack || '',
        suggestion: suggestFor(id, err)
      })
    }
  }

  function suggestFor(id, err) {
    const info = detectPlatform()
    if (err.name === 'NotAllowedError') {
      return '权限被拒绝。请在系统设置或浏览器设置中允许摄像头/蓝牙权限。'
    }
    if (err.name === 'NotFoundError') {
      return id.startsWith('camera') ? '没有检测到可用摄像头。' : '没有发现匹配的 BLE 设备。'
    }
    if (err.name === 'NotReadableError') {
      return '摄像头正被其他程序占用，请关闭其他应用后重试。'
    }
    if (err.name === 'SecurityError') {
      return '浏览器安全策略阻止该操作，请确认页面使用 HTTPS 并重新授权。'
    }
    if (err.name === 'NetworkError') {
      return '模型或 WASM 下载失败，请检查网络后重试。'
    }
    if (id === 'ble-discover' && info.ios) {
      return 'iOS 普通 Safari 不支持 Web Bluetooth，请复制链接到 Bluefy 中打开。'
    }
    if (id === 'mediapipe-init' && info.ios) {
      return 'Bluefy 的 WebKit 兼容性需要真机验证；如果失败，请先测试手动 BLE 和摄像头功能。'
    }
    return ''
  }

  async function stopCamera() {
    stopGestureDetection({ status: 'warn', actual: '手势识别已停止', suggestion: '摄像头被关闭或重新打开。' })
    if (state.cameraStream) {
      for (const track of state.cameraStream.getTracks()) track.stop()
      state.cameraStream = null
    }
    const video = document.getElementById('camera-video')
    if (video) video.srcObject = null
    stopGestureLoop()
  }

  function stopGestureLoop() {
    if (state.gestureRaf) cancelAnimationFrame(state.gestureRaf)
    state.gestureRaf = 0
  }

  function runGestureDetection() {
    if (state.gestureRunning) {
      return { status: 'running', actual: '手势识别已在运行中' }
    }
    state.gestureRunning = true
    state.gestureSeen = false
    state.gestureFrames = 0
    state.gestureHandFrames = 0
    state.gestureLastDebug = 0
    document.getElementById('stopGesture').hidden = false
    document.getElementById('gesture-status').textContent = '正在识别，请把手放到画面中央'
    document.getElementById('gesture-debug').textContent = '调试: 正在初始化识别循环'
    const video = document.getElementById('camera-video')
    const canvas = document.getElementById('gesture-canvas')
    const ctx = canvas.getContext('2d')

    const tick = () => {
      if (!state.gestureRunning) return
      if (video.readyState < 2) {
        state.gestureRaf = requestAnimationFrame(tick)
        return
      }
      const w = video.videoWidth
      const h = video.videoHeight
      if (!w || !h) {
        state.gestureRaf = requestAnimationFrame(tick)
        return
      }
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w
        canvas.height = h
      }
      ctx.clearRect(0, 0, w, h)
      try {
        state.gestureFrames++
        const result = state.landmarker.detectForVideo(video, performance.now())
        const handLandmarks = result.landmarks || result.handLandmarks
        if (handLandmarks && handLandmarks.length) {
          state.gestureHandFrames++
          const landmarks = handLandmarks[0]
          drawHand(ctx, landmarks, w, h)
          const gesture = recognize(landmarks)
          document.getElementById('gesture-status').textContent = `识别到: ${gesture.name}`
          state.gestureSeen = true
        } else {
          document.getElementById('gesture-status').textContent = state.gestureSeen
            ? '手已离开画面，请把手放回来'
            : '等待手进入画面，请把手放到摄像头前'
        }
        if (state.gestureFrames - state.gestureLastDebug >= 30) {
          state.gestureLastDebug = state.gestureFrames
          const debugEl = document.getElementById('gesture-debug')
          debugEl.textContent = [
            '调试: 识别调用正常',
            `摄像头: ${w}x${h}`,
            `已处理帧: ${state.gestureFrames}`,
            `检测到手帧: ${state.gestureHandFrames}`,
            `手部结果: ${handLandmarks ? handLandmarks.length : 0}`
          ].join('\n')
        }
      } catch (err) {
        document.getElementById('gesture-debug').textContent = `调试: ${err.message || err}`
        stopGestureDetection({ status: 'fail', actual: `识别异常: ${err.message}`, suggestion: err.message })
        return
      }
      state.gestureRaf = requestAnimationFrame(tick)
    }

    state.gestureRaf = requestAnimationFrame(tick)
    return { status: 'running', actual: '手势识别已启动，请把手放到摄像头前' }
  }

  function stopGestureDetection(result) {
    if (!state.gestureRunning) return
    state.gestureRunning = false
    stopGestureLoop()
    const stopButton = document.getElementById('stopGesture')
    if (stopButton) stopButton.hidden = true
    const finalResult = result || (state.gestureSeen
      ? { status: 'pass', actual: '手势识别已停止，识别过程中已检测到手部关键点', suggestion: '' }
      : {
          status: 'warn',
          actual: '停止手势识别，未检测到手部',
          suggestion: '请把手放到摄像头画面中央、光线充足后重新开始。'
        })
    patch('gesture-detect', finalResult)
    const canvas = document.getElementById('gesture-canvas')
    const ctx = canvas && canvas.getContext('2d')
    if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height)
  }

  function drawHand(ctx, landmarks, width, height) {
    ctx.strokeStyle = '#22c55e'
    ctx.lineWidth = 3
    ctx.beginPath()
    for (const [a, b] of HAND_CONNECTIONS) {
      const p1 = landmarks[a]
      const p2 = landmarks[b]
      if (!p1 || !p2) continue
      ctx.moveTo(p1.x * width, p1.y * height)
      ctx.lineTo(p2.x * width, p2.y * height)
    }
    ctx.stroke()
    ctx.fillStyle = '#ef4444'
    for (const p of landmarks) {
      ctx.beginPath()
      ctx.arc(p.x * width, p.y * height, 4, 0, Math.PI * 2)
      ctx.fill()
    }
  }

  function dist(a, b) {
    return Math.hypot(a.x - b.x, a.y - b.y)
  }

  function angle3(a, b, c) {
    const v1 = [a.x - b.x, a.y - b.y, a.z - b.z]
    const v2 = [c.x - b.x, c.y - b.y, c.z - b.z]
    const dot = v1[0] * v2[0] + v1[1] * v2[1] + v1[2] * v2[2]
    const len = Math.hypot(...v1) * Math.hypot(...v2)
    if (!len) return 0
    return Math.acos(Math.max(-1, Math.min(1, dot / len))) * 180 / Math.PI
  }

  function recognize(landmarks) {
    const tips = [4, 8, 12, 16, 20]
    const pips = [2, 6, 10, 14, 18]
    const wrist = landmarks[0]
    const fingers = [0, 0, 0, 0, 0]
    for (let i = 0; i < tips.length; i++) {
      const tip = landmarks[tips[i]]
      const pip = landmarks[pips[i]]
      if (dist(tip, wrist) > dist(pip, wrist) * 0.8) fingers[i] = 1
    }
    fingers[0] = angle3(landmarks[2], landmarks[3], landmarks[4]) > 160 ? 1 : 0
    const count = fingers.reduce((sum, v) => sum + v, 0)
    let name = `手势 ${count}`
    if (count === 0) name = '握拳 (Fist)'
    else if (count === 5) name = '张开 (Open Palm)'
    else {
      const labels = ['拇指', '食指', '中指', '无名指', '小指']
      name = labels.filter((_, i) => fingers[i]).join(' + ') || '握拳'
    }
    return { fingers, name }
  }

  function buildReport() {
    const info = detectPlatform()
    return JSON.stringify({
      timestamp: new Date().toISOString(),
      page: location.href,
      platform: info,
      modelUrl: MODEL_PATH,
      mediapipe: CDN_BASE,
      results: TESTS.map((t) => ({
        id: t.id,
        name: t.name,
        group: t.group,
        status: t.status || 'pending',
        expected: t.expected,
        actual: t.actual || '',
        errorName: t.errorName || '',
        errorMessage: t.errorMessage || '',
        suggestion: t.suggestion || ''
      }))
    }, null, 2)
  }

  function updateSummary() {
    const counts = {
      pass: 0,
      warn: 0,
      fail: 0,
      pending: 0,
      running: 0
    }
    for (const t of TESTS) {
      const key = t.status || 'pending'
      if (key in counts) counts[key]++
    }
    const el = document.getElementById('summary')
    if (counts.fail) {
      el.textContent = `失败 ${counts.fail} 项，警告 ${counts.warn} 项，通过 ${counts.pass} 项，未完成 ${counts.pending + counts.running} 项`
    } else if (counts.warn) {
      el.textContent = `通过 ${counts.pass} 项，警告 ${counts.warn} 项，未完成 ${counts.pending + counts.running} 项`
    } else {
      el.textContent = `通过 ${counts.pass} 项，警告 ${counts.warn} 项，未完成 ${counts.pending + counts.running} 项`
    }
  }

  async function copyReport() {
    const text = buildReport()
    try {
      await navigator.clipboard.writeText(text)
      document.getElementById('summary').textContent = '测试报告已复制到剪贴板'
    } catch (err) {
      const area = document.createElement('textarea')
      area.value = text
      document.body.appendChild(area)
      area.select()
      document.execCommand('copy')
      area.remove()
      document.getElementById('summary').textContent = '测试报告已复制'
    }
  }

  function downloadReport() {
    const blob = new Blob([buildReport()], { type: 'application/json' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `robothand-test-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}.json`
    a.click()
    URL.revokeObjectURL(url)
  }

  document.getElementById('runAuto').addEventListener('click', runAutoTests)
  document.getElementById('copyReport').addEventListener('click', copyReport)
  document.getElementById('downloadReport').addEventListener('click', downloadReport)
  document.getElementById('stopGesture').addEventListener('click', () => stopGestureDetection())
  document.getElementById('closeCamera').addEventListener('click', () => {
    stopGestureDetection({ status: 'warn', actual: '手势识别已停止', suggestion: '摄像头已关闭。' })
    stopCamera()
    document.getElementById('camera-preview').hidden = true
    patch('camera-open', {
      status: 'pending',
      actual: '摄像头已手动关闭',
      suggestion: '点击“打开摄像头”可重新开启。'
    })
  })

  renderTests()
  updateSummary()

  window.addEventListener('beforeunload', () => {
    stopCamera()
    if (state.bleServer && state.bleServer.connected) {
      state.bleServer.disconnect().catch(() => {})
    }
  })
</script>
